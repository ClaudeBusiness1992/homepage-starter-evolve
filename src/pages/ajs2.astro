---
// /ajs2 leitet seit 24.11.2026 (Nick) dauerhaft auf /ajs weiter.
// Die ajs/ajs2-Trennung ist ersetzt durch das Rollen-Login auf EINER Seite /ajs
// (Kunde: Seite · Designer: +Editor+Audit · Admin: +Admin).
// Diese Datei bleibt nur als Weiterleitung bestehen, damit alte Lesezeichen
// und der PreviewLogin-Eintrag „ajs2“ weiterhin ankommen.
const target = '/ajs';
---
<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Weiterleitung · AJ&rsquo;s Inner Circle</title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href={target} />
  <meta http-equiv="refresh" content={`0; url=${target}`} />
  <script is:inline>
    (function () {
      var hash = location.hash || '';
      var search = location.search || '';
      location.replace('/ajs' + search + hash);
    }());
  </script>
</head>
<body>
  <main style="font-family: system-ui, sans-serif; padding: 2rem; text-align: center;">
    <p>Diese Vorschau ist umgezogen.</p>
    <p><a href="/ajs">Weiter zu /ajs</a></p>
  </main>
</body>
</html>
