---
import metaConfig    from '../../config/meta.json';
import contentConfig from '../../config/content.json';
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../sections/Footer.astro';
import DatenschutzContent from '../components/legal/DatenschutzContent.astro';

const { meta, theme } = metaConfig;
const { sections: s } = contentConfig;
---

<Base meta={{ siteName: meta.siteName + ' — Datenschutz', description: 'Datenschutzerklärung gemäß DSGVO' }} theme={theme} noindex={true}>
  <Nav siteName={meta.siteName} siteNameAccent={meta.siteNameAccent} links={meta.nav} />

  <main id="main" class="legal-page">
    <div class="wrap legal-wrap">
      <p class="legal-kicker">Rechtliches</p>
      <h1 class="legal-h1">Datenschutzerklärung</h1>
      <hr class="legal-rule" aria-hidden="true" />

      <DatenschutzContent level={2} />
    </div>
  </main>

  {s.footer.enabled && <Footer siteName={meta.siteName} siteNameAccent={meta.siteNameAccent} copyright={meta.copyright} links={s.footer.links} />}
</Base>
