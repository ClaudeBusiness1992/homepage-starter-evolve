---
interface NavLink {
  label: string;
  href: string;
  section?: string;
  cta?: boolean;
  outline?: boolean;
}
interface Props {
  siteName: string;
  siteNameAccent?: string;
  logo?: string;
  links?: NavLink[];
}
const { siteName, siteNameAccent, logo, links = [] } = Astro.props;
// Inhalts-Links zuerst, Aktions-Buttons (Einloggen / Mitglied werden) immer ganz rechts dahinter.
const isAction = (l: NavLink) => !!(l.cta || l.outline || l.section === 'login' || l.section === 'register');
const contentLinks = links.filter(l => !isAction(l) && l.section !== 'contact');
const contactLink = links.find(l => l.section === 'contact');
const actionLinks = links.filter(l => isAction(l));
const accentIdx = siteNameAccent ? siteName.indexOf(siteNameAccent) : -1;
const logoBefore = accentIdx > -1 ? siteName.slice(0, accentIdx) : siteName;
const logoAfter  = accentIdx > -1 ? siteName.slice(accentIdx + (siteNameAccent?.length ?? 0)) : '';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = path === '/ajs' || path === '/ajs2' || path === '/';
const base = path.startsWith('/ajs2') ? '/ajs2' : path.startsWith('/ajs') ? '/ajs' : '/ajs';
const resolveHref = (href: string) => (isHome || !href.startsWith('#')) ? href : `${base}${href}`;
---

<nav id="nav" aria-label="Hauptnavigation">
  <div class="wrap">
    <div class="nav-row">
      <a href="#top" class="logo nav-brand">{logo && <img src={logo} alt="" class="logo-img" width="44" height="44" />}<span>{logoBefore}{siteNameAccent && <em>{siteNameAccent}</em>}{logoAfter}</span></a>
      {links.length > 0 && (
        <ul class="nav-ul nav-center" id="navLinks">
          {contentLinks.map(l => (
            <li>
              <a href={resolveHref(l.href)}>{l.label}</a>
            </li>
          ))}
          {(contactLink || actionLinks.length > 0) && (
            <li class="nav-action-mobile nav-action-group-mobile">
              {contactLink && <a href={resolveHref(contactLink.href)} class="nav-contact-link">{contactLink.label}</a>}
              {actionLinks.map(l => (
                <a href={resolveHref(l.href)} class={l.cta ? 'cta-link' : 'nav-btn-outline'}>{l.label}</a>
              ))}
            </li>
          )}
        </ul>
      )}
      {(contactLink || actionLinks.length > 0) && (
        <div class="nav-actions-desktop nav-action-group">
          {contactLink && <a href={resolveHref(contactLink.href)} class="nav-contact-link">{contactLink.label}</a>}
          {actionLinks.map(l => (
            <a href={resolveHref(l.href)} class={l.cta ? 'cta-link' : 'nav-btn-outline'}>{l.label}</a>
          ))}
        </div>
      )}
      <button class="burger" id="burger" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
/* Navi-Umbruch (HPSE-AJS-NAVWRAP): --nav-h der echten Leistenhöhe nachführen,
   damit Hero-Padding, Scroll-Padding und Anker-Offsets bei zweizeiliger Navi stimmen.
   Guard h > 0: läuft auch hinter dem ClientGate (dort display:none bis Unlock). */
(function () {
  var nav = document.getElementById('nav');
  if (!nav) return;
  function sync() {
    var h = nav.offsetHeight;
    if (h > 0) document.documentElement.style.setProperty('--nav-h', h + 'px');
  }
  sync();
  window.addEventListener('resize', sync, { passive: true });
  if ('ResizeObserver' in window) new ResizeObserver(sync).observe(nav);
})();
</script>
