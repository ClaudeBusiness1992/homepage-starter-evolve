---
import SectionHeader from '../components/SectionHeader.astro';
interface Package {
  name: string;
  tagline?: string;
  period?: string;
  price: string;
  priceNote?: string;
  featured?: boolean;
  highlight?: boolean;
  badge?: string;
  features: string[];
  ctaLabel?: string;
  ctaHref?: string;
}
interface Props {
  label: string;
  headline: string;
  subline: string;
  packages: Package[];
}
const { label, headline, subline, packages } = Astro.props;
const delays = ['d1','d2','d3'];
---

<section class="section" id="pricing">
  <div class="wrap">
    <SectionHeader {label} {headline} {subline} center />
    <div class="pricing-grid">
      {packages.map((pkg, i) => {
        const isFeat = pkg.featured || pkg.highlight;
        const subTag = pkg.tagline || pkg.period || '';
        const ctaTxt = pkg.ctaLabel || (isFeat ? 'Jetzt anfragen' : 'Anfragen');
        const ctaUrl = pkg.ctaHref || '#contact';
        return (
          <article
            class={`pcard r ${delays[i % delays.length]} ${isFeat ? 'feat' : ''}`}
            aria-label={pkg.name}
          >
            {pkg.badge && <div class="pbadge">{pkg.badge}</div>}
            <h3 class="pname">{pkg.name}</h3>
            {subTag && <span class="ptag">{subTag}</span>}
            <div class="pprice">
              <div class="amount">{pkg.price}</div>
              {pkg.priceNote && <div class="note">{pkg.priceNote}</div>}
            </div>
            <div class="pdiv"></div>
            <ul class="plist">
              {pkg.features.map(f => <li>{f}</li>)}
            </ul>
            <a href={ctaUrl} class={`btn btn-w ${isFeat ? 'btn-fill' : 'btn-outline'}`}
              aria-label={`${ctaTxt} — Paket ${pkg.name}`}>
              {ctaTxt}
            </a>
          </article>
        );
      })}
    </div>
    <p class="pricing-note r">
      Alle Pakete individuell anpassbar.
      <a href="#contact">Schreiben Sie uns</a> für ein maßgeschneidertes Angebot.
    </p>
  </div>
</section>

<script is:inline>
  (() => {
    const cards = document.querySelectorAll('#pricing .pcard');
    if (!cards.length) return;

    const select = (card) => {
      if (card.classList.contains('feat')) return;
      cards.forEach((c) => {
        c.classList.remove('feat');
        const btn = c.querySelector('.btn');
        if (btn) {
          btn.classList.replace('btn-fill', 'btn-outline');
          btn.textContent = 'Anfragen';
          btn.setAttribute('aria-label', `Anfragen — Paket ${c.getAttribute('aria-label')}`);
        }
      });
      card.classList.add('feat');
      const btn = card.querySelector('.btn');
      if (btn) {
        btn.classList.replace('btn-outline', 'btn-fill');
        btn.textContent = 'Jetzt anfragen';
        btn.setAttribute('aria-label', `Jetzt anfragen — Paket ${card.getAttribute('aria-label')}`);
      }
    };

    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('a.btn')) return;
        select(card);
      });
    });
  })();
</script>
