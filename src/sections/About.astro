---
import SectionHeader from '../components/SectionHeader.astro';
import { getDb } from '../lib/db';
import { isSectionEnabled } from '../lib/permissions';
import '../styles/team-adaptive.css';

interface Member {
  name: string;
  role: string;
  bio: string;
  photo: string;
  department?: string;
}

interface Props {
  label: string;
  headline: string;
  subline: string;
  intro?: string;
  members: Member[];
}

const { label, headline, subline, intro, members = [] } = Astro.props;

let dbMembers: any[] = [];
try {
  const db = getDb();
  dbMembers = db.prepare('SELECT * FROM team_members WHERE is_published = 1 ORDER BY sort_order ASC').all();
} catch (e) {}

const dynamicMembers: Member[] = dbMembers.length > 0 ? dbMembers.map((m: any) => ({
  name: m.name,
  role: m.role,
  bio: m.bio,
  photo: m.photo_url,
  department: 'Team'
})) : members;

const memberCount = dynamicMembers.length;
const layoutClass = memberCount === 1 ? 'team-layout-single'
  : memberCount === 2 ? 'team-layout-duo'
  : memberCount === 3 ? 'team-layout-trio'
  : memberCount === 4 ? 'team-layout-quad'
  : memberCount === 5 ? 'team-layout-5'
  : memberCount === 6 ? 'team-layout-6'
  : memberCount === 7 ? 'team-layout-7'
  : 'team-layout-multi';


// Beispiel-Erweiterung für Team / Abteilungen:
// Abteilungen mit jeweils unterschiedlicher Anzahl an Personen:
// Controlling: 2 Personen
// Verkauf: 4 Personen
// Einkauf: 1 Person
// Marketing: 5 Personen
// HR: 2 Personen
// Führung: 3 Personen (Sarah Lindner + 2 Gründer/CEOs)
const teamSpecialists: Member[] = [
  // 1. Controlling (2 Personen)
  {
    name: 'Fabian Richter',
    role: 'Financial Controlling',
    bio: 'Verantwortet Budgetplanung, Liquiditätssteuerung und präzise Kennzahlenanalysen für alle Projekte.',
    photo: 'https://i.pravatar.cc/600?img=68',
    department: 'Controlling'
  },
  {
    name: 'Katharina Weiß',
    role: 'Projekt-Controlling',
    bio: 'Überwacht Ressourcen, Kostenstrukturen und Wirtschaftlichkeit laufender Kundenaufträge.',
    photo: 'https://i.pravatar.cc/600?img=49',
    department: 'Controlling'
  },

  // 2. Verkauf (4 Personen)
  {
    name: 'Maximilian Schwarz',
    role: 'Key Account Management',
    bio: 'Betreut strategische Firmenkunden und entwickelt passgenaue digitale Lösungspakete.',
    photo: 'https://i.pravatar.cc/600?img=59',
    department: 'Verkauf'
  },
  {
    name: 'Laura Hoffmann',
    role: 'Sales Representative',
    bio: 'Begleitet Neukunden von der ersten Anfrage bis zum maßgeschneiderten Vertragsabschluss.',
    photo: 'https://i.pravatar.cc/600?img=45',
    department: 'Verkauf'
  },
  {
    name: 'Tim Sommer',
    role: 'Vertrieb & Partnerschaften',
    bio: 'Baut nachhaltige Kooperationen und regionale Kundenbeziehungen kontinuierlich aus.',
    photo: 'https://i.pravatar.cc/600?img=60',
    department: 'Verkauf'
  },
  {
    name: 'Nadine Wagner',
    role: 'Client Success Manager',
    bio: 'Stellt eine erstklassige Betreuung nach Projektabschluss und langfristige Zufriedenheit sicher.',
    photo: 'https://i.pravatar.cc/600?img=36',
    department: 'Verkauf'
  },

  // 3. Einkauf (1 Person)
  {
    name: 'Moritz Bauer',
    role: 'Strategischer Einkauf & Procurement',
    bio: 'Steuert Lieferantenbeziehungen, Softwarelizenzen und Verhandlungen für beste Konditionen.',
    photo: 'https://i.pravatar.cc/600?img=11',
    department: 'Einkauf'
  },

  // 4. Marketing (5 Personen)
  {
    name: 'Elena Rost',
    role: 'Content & Copywriting',
    bio: 'Verfasst überzeugende Texte und schärft das Markenprofil für kleine und mittlere Unternehmen.',
    photo: 'https://i.pravatar.cc/600?img=44',
    department: 'Marketing'
  },
  {
    name: 'Julian Vogt',
    role: 'Performance Marketing & SEO',
    bio: 'Betreut datengestützte Kampagnen und sorgt für nachhaltige Reichweite bei Google und Social Media.',
    photo: 'https://i.pravatar.cc/600?img=12',
    department: 'Marketing'
  },
  {
    name: 'Sophie Hartmann',
    role: 'Brand & Campaign Design',
    bio: 'Konzipiert visuelle Markenauftritte und reichweitenstarke digitale Werbemittel.',
    photo: 'https://i.pravatar.cc/600?img=28',
    department: 'Marketing'
  },
  {
    name: 'Jonas Keller',
    role: 'Social Media & Community',
    bio: 'Gestaltet ansprechende Posts, Reels und Storys zur Stärkung der Unternehmenspräsenz.',
    photo: 'https://i.pravatar.cc/600?img=33',
    department: 'Marketing'
  },
  {
    name: 'Clara Busch',
    role: 'SEO & Inbound Marketing',
    bio: 'Optimiert Webseiten auf organische Auffindbarkeit und messbare Lead-Generierung.',
    photo: 'https://i.pravatar.cc/600?img=41',
    department: 'Marketing'
  },

  // 5. HR (2 Personen)
  {
    name: 'Melanie König',
    role: 'Talent Acquisition & Recruiting',
    bio: 'Findet herausragende Fachkräfte und gestaltet einen wertschätzenden Bewerbungsprozess.',
    photo: 'https://i.pravatar.cc/600?img=38',
    department: 'HR'
  },
  {
    name: 'Christian Meyer',
    role: 'People & Culture Manager',
    bio: 'Fördert Teamentwicklung, Weiterbildungsprogramme und eine moderne Unternehmenskultur.',
    photo: 'https://i.pravatar.cc/600?img=15',
    department: 'HR'
  },

  // 6. Führung (Spezialisten vor Gründer/Geschäftsführung)
  {
    name: 'Sarah Lindner',
    role: 'Head of Operations & Design',
    bio: 'Koordiniert Abteilungsabläufe, Projektstrukturen und Qualitätsstandards im gesamten Team.',
    photo: 'https://i.pravatar.cc/600?img=47',
    department: 'Führung'
  }
];

// Gründer / Geschäftsführung / CEO kommen zum Schluss in 'Führung'
const sampleTeamMembers: Member[] = [
  ...teamSpecialists,
  ...members.map((m) => ({
    ...m,
    department: 'Führung'
  }))
];

// Feste, fachlich saubere Reihenfolge der Abteilungen:
const departmentOrder = ['Controlling', 'Verkauf', 'Einkauf', 'Marketing', 'HR', 'Führung'];
const availableDepts = [...new Set(sampleTeamMembers.map(m => m.department).filter(Boolean))];
const departments = departmentOrder.filter(d => availableDepts.includes(d));
---

<section class="section" id="about">
  <div class="wrap">
    <div class="section-hd r section-hd--center">
      {label && <span class="lbl">{label}</span>}
      <h2 class="h2 about-headline-duo" set:html={headline} />
      <h2 class="h2 about-headline-solo" style="display: none;">Leidenschaft für starkes Webdesign</h2>
      <h2 class="h2 about-headline-team" style="display: none;">Unser Team, eine Vision</h2>
      <p class="sub about-subline-duo">{subline}</p>
      <p class="sub about-subline-solo" style="display: none;">Persönliche Betreuung, direkte Kommunikation und individuelle Weblösungen aus einer Hand.</p>
      <p class="sub about-subline-team" style="display: none;">Erfahrene Spezialisten für Design, Entwicklung, Marketing und Strategie — vereint für Ihren digitalen Erfolg.</p>
    </div>

    <!-- Abteilungs-Filter (wird nur im Team-Modus sichtbar geschaltet) -->
    <div class="about-depts" id="about-dept-filters" hidden>
      {departments.map((dept, i) => (
        <button type="button" class={`about-dept-btn${i === 0 ? ' is-active' : ''}`} data-dept={dept}>
          {dept}
        </button>
      ))}
    </div>

    <!-- 1. Deterministisches Team Grid (passt sich automatisch jedem N an).
         Reihenfolge-Garantie Duo/Solo: Foto (.aphoto) immer oben,
         Name/Rolle/Bio (.abody) immer darunter — nie daneben. -->
    <div class={`about-grid team-adaptive-container ${layoutClass}`} id="about-default-grid">
      {dynamicMembers.map((m, i) => (
        <div class={`acard team-card r d${i + 1}`}>
          <div class="aphoto team-card-photo" {...(m.photo ? {'data-lightbox': m.photo, 'data-alt': m.name, 'data-caption': m.name, 'data-category': m.role, 'data-description': m.bio, 'tabindex': '0', 'role': 'button', 'aria-label': `Foto von ${m.name} vergrößern`} : {})}>
            {m.photo
              ? <img src={m.photo} alt={m.name} width="800" height="1000" loading="lazy" />
              : <div class="team-card-avatar">{m.name.split(' ').map(n => n[0]).join('').slice(0, 2)}</div>
            }
          </div>
          <div class="abody team-card-body">
            <h3 class="aname team-card-name">{m.name}</h3>
            <span class="arole team-card-role">{m.role}</span>
            <p class="atext team-card-bio">{m.bio}</p>
          </div>
        </div>
      ))}
    </div>

    <!-- 2. Team Carousel Container (2 Reihen mit max 3 Spalten, Swipe links/rechts) -->
    <div class="about-team-carousel" id="about-team-carousel" hidden>
      <button type="button" class="about-team-nav about-team-nav--prev" id="about-team-prev" aria-label="Vorherige Teammitglieder">‹</button>
      <div class="about-team-track" id="about-team-track">
        {sampleTeamMembers.map((m, i) => (
          <div class="acard team-card" data-member-dept={m.department}>
            <div class="aphoto" {...(m.photo ? {'data-lightbox': m.photo, 'data-alt': m.name, 'data-caption': m.name, 'data-category': m.role, 'data-description': m.bio, 'tabindex': '0', 'role': 'button', 'aria-label': `Foto von ${m.name} vergrößern`} : {})}>
              <img src={m.photo} alt={m.name} width="600" height="800" loading="lazy" />
            </div>
            <div class="abody">
              <span class="team-dept-tag">{m.department}</span>
              <h3 class="aname">{m.name}</h3>
              <span class="arole">{m.role}</span>
              <p class="atext">{m.bio}</p>
            </div>
          </div>
        ))}
      </div>
      <button type="button" class="about-team-nav about-team-nav--next" id="about-team-next" aria-label="Nächste Teammitglieder">›</button>
    </div>
  </div>
</section>

<script is:inline>
(() => {
  const track = document.getElementById('about-team-track');
  const prev = document.getElementById('about-team-prev');
  const next = document.getElementById('about-team-next');
  const deptButtons = document.querySelectorAll('.about-dept-btn');

  // Abteilungs-Navigation & Filterung
  const applyFilterByIndex = (targetIdx) => {
    if (targetIdx < 0 || targetIdx >= deptButtons.length) return;
    deptButtons.forEach((b, i) => b.classList.toggle('is-active', i === targetIdx));
    const btn = deptButtons[targetIdx];
    const dept = btn.getAttribute('data-dept');
    const cards = track?.querySelectorAll('.team-card') || [];
    let visibleCount = 0;
    cards.forEach(card => {
      const cDept = card.getAttribute('data-member-dept');
      const matches = (cDept === dept);
      card.style.display = matches ? '' : 'none';
      if (matches) visibleCount++;
    });
    if (track) {
      track.setAttribute('data-visible-count', String(visibleCount));
      track.scrollLeft = 0;
    }
    updateNav();
  };

  const updateNav = () => {
    if (!track) return;
    const currentIdx = Array.from(deptButtons).findIndex(b => b.classList.contains('is-active'));
    const maxScroll = track.scrollWidth - track.clientWidth;
    const canScrollLeft = track.scrollLeft > 2;
    const canScrollRight = track.scrollLeft < maxScroll - 2;

    // Pfeil nach links: aktiv, wenn im Track scrollbar ODER eine vorherige Abteilung existiert
    if (prev) {
      prev.hidden = !canScrollLeft && currentIdx <= 0;
    }
    // Pfeil nach rechts: aktiv, wenn im Track scrollbar ODER eine nächste Abteilung existiert
    if (next) {
      next.hidden = !canScrollRight && currentIdx >= deptButtons.length - 1;
    }
  };

  const currentDeptIdx = () => Array.from(deptButtons).findIndex(b => b.classList.contains('is-active'));

  const goToDept = (idx) => {
    if (idx >= 0 && idx < deptButtons.length) applyFilterByIndex(idx);
  };
  const goToPrevDept = () => {
    const i = currentDeptIdx();
    if (i > 0) goToDept(i - 1);
  };
  const goToNextDept = () => {
    const i = currentDeptIdx();
    if (i >= 0 && i < deptButtons.length - 1) goToDept(i + 1);
  };
  const atLeftEdge = () => !track || track.scrollLeft <= 4;
  const atRightEdge = () => {
    if (!track) return true;
    return track.scrollLeft >= track.scrollWidth - track.clientWidth - 4;
  };

  if (prev && next && track) {
    prev.addEventListener('click', () => {
      const canScrollLeft = track.scrollLeft > 2;
      if (canScrollLeft) {
        track.scrollBy({ left: -track.clientWidth * 0.8, behavior: 'smooth' });
      } else {
        goToPrevDept();
      }
    });

    next.addEventListener('click', () => {
      const maxScroll = track.scrollWidth - track.clientWidth;
      const canScrollRight = track.scrollLeft < maxScroll - 2;
      if (canScrollRight) {
        track.scrollBy({ left: track.clientWidth * 0.8, behavior: 'smooth' });
      } else {
        goToNextDept();
      }
    });

    track.addEventListener('scroll', updateNav, { passive: true });
    window.addEventListener('resize', updateNav);

    // Horizontales Swipen: Touch-Geste …
    const SWIPE_MIN = 50;
    const SWIPE_EDGE_TOL = 40;
    let touchStartX = null;
    let touchStartY = null;
    track.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      touchStartX = t.clientX;
      touchStartY = t.clientY;
    }, { passive: true });
    track.addEventListener('touchend', (e) => {
      if (touchStartX === null) return;
      const t = e.changedTouches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      touchStartX = null;
      touchStartY = null;
      if (Math.abs(dx) < SWIPE_MIN || Math.abs(dx) <= Math.abs(dy)) return;
      if (dx < 0) {
        if (track.scrollLeft >= track.scrollWidth - track.clientWidth - SWIPE_EDGE_TOL) goToNextDept();
      } else {
        if (track.scrollLeft <= SWIPE_EDGE_TOL) goToPrevDept();
      }
    }, { passive: true });

    // … Maus-Drag mit Drag-Scroll …
    let dragStartX = null;
    let dragStartScroll = 0;
    let dragged = false;
    let suppressClick = false;
    track.addEventListener('pointerdown', (e) => {
      if (e.pointerType !== 'mouse' || e.button !== 0) return;
      dragStartX = e.clientX;
      dragStartScroll = track.scrollLeft;
      dragged = false;
    });
    window.addEventListener('pointermove', (e) => {
      if (dragStartX === null) return;
      const dx = e.clientX - dragStartX;
      if (Math.abs(dx) > 12) dragged = true;
      if (dragged) track.scrollLeft = dragStartScroll - dx;
    });
    window.addEventListener('pointerup', (e) => {
      if (dragStartX === null) return;
      const dx = e.clientX - dragStartX;
      const wasDragged = dragged;
      dragStartX = null;
      dragged = false;
      if (!wasDragged) return;
      if (Math.abs(dx) >= 60) {
        suppressClick = true;
        if (dx < 0) {
          if (atRightEdge()) goToNextDept();
        } else {
          if (atLeftEdge()) goToPrevDept();
        }
      }
    });
    track.addEventListener('click', (e) => {
      if (suppressClick) {
        suppressClick = false;
        e.stopPropagation();
        e.preventDefault();
      }
    }, true);

    // … und Trackpad (horizontales Scrollen am Anschlag wechselt die Abteilung)
    let wheelAcc = 0;
    let wheelCoolUntil = 0;
    let wheelResetT = null;
    track.addEventListener('wheel', (e) => {
      if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
      const outward = (e.deltaX > 0 && atRightEdge()) || (e.deltaX < 0 && atLeftEdge());
      if (!outward) { wheelAcc = 0; return; }
      if (Date.now() < wheelCoolUntil) return;
      wheelAcc += e.deltaX;
      clearTimeout(wheelResetT);
      wheelResetT = setTimeout(() => { wheelAcc = 0; }, 250);
      if (Math.abs(wheelAcc) > 80) {
        wheelAcc = 0;
        wheelCoolUntil = Date.now() + 1200;
        if (e.deltaX > 0) goToNextDept();
        else goToPrevDept();
      }
    }, { passive: true });
  }

  deptButtons.forEach((btn, idx) => {
    btn.addEventListener('click', () => {
      applyFilterByIndex(idx);
    });
  });

  // Initial ersten Bereich aktivieren
  applyFilterByIndex(0);
})();
</script>
