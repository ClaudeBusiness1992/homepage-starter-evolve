  // 5. HR (2 Personen)
  {
    name: 'Melanie König',
    role: 'Talent Acquisition & Recruiting',
    bio: 'Findet herausragende Fachkräfte und gestaltet einen wertschätzenden Bewerbungsprozess.',
    photo: 'https://i.pravatar.cc/600?img=38',
    department: 'HR'
  },
  {
    name: 'Christian Meyer',
    role: 'People & Culture Manager',
    bio: 'Fördert Teamentwicklung, Weiterbildungsprogramme und eine moderne Unternehmenskultur.',
