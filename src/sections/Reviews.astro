---
import SectionHeader from '../components/SectionHeader.astro';
import CarouselScript from '../components/CarouselScript.astro';
import legalConfig from '../../config/legal.json';

interface Review {
  name: string;
  company: string;
  rating: number;
  verified: boolean;
  date: string;
  text: string;
}
interface StatItem { value: number; label: string; }
interface Props {
  label: string;
  headline: string;
  subline: string;
  items: Review[];
  stats?: StatItem[];
  agencyName?: string;
  agencyUrl?: string;
  telephone?: string;
}
const { label, headline, subline, items, stats = [], agencyName = '', agencyUrl, telephone } = Astro.props;

const { legal: l } = legalConfig;
const isPlaceholder = (v: string) => !v || v.startsWith('[');
const hasAddress = !isPlaceholder(l.address.street) && !isPlaceholder(l.address.city);
const hasTel = !isPlaceholder(telephone ?? '') || !isPlaceholder(l.contact.phone);
const tel = !isPlaceholder(telephone ?? '') ? telephone : (!isPlaceholder(l.contact.phone) ? l.contact.phone : undefined);
const delays = ['d1', 'd2', 'd3'];

const avg = items.length
  ? (items.reduce((s, r) => s + r.rating, 0) / items.length).toFixed(1)
  : '0';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': '#business',
  name: agencyName,
  ...(agencyUrl ? { url: agencyUrl } : {}),
  ...(tel ? { telephone: tel } : {}),
  ...(hasAddress ? {
    address: {
      '@type': 'PostalAddress',
      streetAddress: l.address.street,
      postalCode: l.address.zip,
      addressLocality: l.address.city,
      addressCountry: 'DE',
    }
  } : {}),
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: avg,
    reviewCount: items.length,
    bestRating: 5,
  },
  review: items.map(r => ({
    '@type': 'Review',
    author: { '@type': 'Person', name: r.name },
    reviewRating: { '@type': 'Rating', ratingValue: r.rating, bestRating: 5 },
    reviewBody: r.text,
    datePublished: r.date,
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<section class="section" id="reviews">
  <div class="wrap">
    <SectionHeader {label} {headline} {subline} center />
    <div class="reviews-switch-nav" id="reviews-view-switch">
      <button type="button" class="reviews-switch-btn is-active" data-rev-view="carousel">Kundenstimmen</button>
      <button type="button" class="reviews-switch-btn" data-rev-view="verified">Geprüfte Auftraggeber</button>
    </div>
    {stats.length > 0 && (
      <div class="reviews-stats">
        {stats.map(s => (
          <div class="reviews-stat">
            <div class="reviews-stat-v">{s.value}</div>
            <div class="reviews-stat-l">{s.label}</div>
          </div>
        ))}
      </div>
    )}
    <div class="reviews-carousel" data-carousel>
      <button type="button" class="gallery-nav gallery-nav--prev" aria-label="Vorherige Bewertungen" data-carousel-prev>‹</button>
      <div class="reviews-grid" data-carousel-track data-carousel-item=".review-card">
        {items.map((review, i) => (
          <div class={`review-card r ${delays[i % 3]}`}>
            <div class="review-top">
              <div class="review-stars" aria-label={`${review.rating} von 5 Sternen`}>
                {Array.from({ length: review.rating }).map(() => <span aria-hidden="true">★</span>)}
              </div>
              {review.verified && (
                <span class="review-verified" title={agencyName ? `Echtheit wurde von ${agencyName} geprüft` : 'Echtheit geprüft'}>
                  ✓ Verifiziert
                </span>
              )}
            </div>
            <p class="review-text">„{review.text}"</p>
            <div class="review-footer">
              <div class="review-author">
                <div class="review-avatar">{review.name.charAt(0)}</div>
                <div>
                  <div class="review-name">{review.name}</div>
                  <div class="review-company">{review.company}</div>
                </div>
              </div>
              {review.date && <div class="review-date">{review.date}</div>}
            </div>
          </div>
        ))}
      </div>
      <button type="button" class="gallery-nav gallery-nav--next" aria-label="Nächste Bewertungen" data-carousel-next>›</button>
    </div>
    <p class="reviews-note r">
      ✓ Alle Bewertungen stammen von verifizierten Kunden, die unsere Leistungen tatsächlich
      in Anspruch genommen haben. Die Echtheit jeder Bewertung wurde von uns geprüft und
      dokumentiert — gemäß EU-Omnibus-Richtlinie (2022/161/EU).
    </p>
  </div>
</section>

<CarouselScript />

<script is:inline>
(() => {
  const switchContainer = document.getElementById("reviews-view-switch");
  if (!switchContainer) return;

  const btnCarousel = switchContainer.querySelector("[data-rev-view='carousel']");
  const btnVerified = switchContainer.querySelector("[data-rev-view='verified']");
  const secReviews = document.getElementById("reviews");
  const secVerified = document.getElementById("verified-reviews");

  // Initial: #reviews ist sichtbar, #verified-reviews ist ausgeblendet
  if (secVerified) {
    secVerified.style.display = "none";
  }

  function setView(view) {
    if (!secReviews || !secVerified) return;
    if (view === "carousel") {
      secReviews.style.display = "";
      secVerified.style.display = "none";
      btnCarousel?.classList.add("is-active");
      btnVerified?.classList.remove("is-active");
      secReviews.scrollIntoView({ behavior: "smooth" });
    } else {
      secReviews.style.display = "none";
      secVerified.style.display = "";
      let vSwitch = secVerified.querySelector("#reviews-view-switch-clone");
      if (!vSwitch) {
        const wrap = secVerified.querySelector(".wrap");
        const hd = secVerified.querySelector(".section-hd");
        if (wrap && hd) {
          vSwitch = document.createElement("div");
          vSwitch.id = "reviews-view-switch-clone";
          vSwitch.className = "reviews-switch-nav";
          vSwitch.innerHTML = `
            <button type="button" class="reviews-switch-btn" data-rev-view="carousel">Kundenstimmen</button>
            <button type="button" class="reviews-switch-btn is-active" data-rev-view="verified">Geprüfte Auftraggeber</button>
          `;
          hd.insertAdjacentElement("afterend", vSwitch);
          vSwitch.querySelector("[data-rev-view='carousel']")?.addEventListener("click", () => setView("carousel"));
          vSwitch.querySelector("[data-rev-view='verified']")?.addEventListener("click", () => setView("verified"));
        }
      } else {
        vSwitch.querySelector("[data-rev-view='carousel']")?.classList.remove("is-active");
        vSwitch.querySelector("[data-rev-view='verified']")?.classList.add("is-active");
      }
      secVerified.scrollIntoView({ behavior: "smooth" });
    }
  }

  btnCarousel?.addEventListener("click", () => setView("carousel"));
  btnVerified?.addEventListener("click", () => setView("verified"));
})();
</script>
