  /* 3 Personen: 3 Spalten nebeneinander, Side-by-Side Split wie alle Teamkacheln */
  :global(.about-team-track[data-visible-count="3"]) {
    grid-template-rows: 1fr !important;
    grid-template-columns: repeat(3, 1fr) !important;
