---
/* LiveEditor.astro — Modulare Bearbeitungsleiste mit Accordion & Darstellungsoptionen */
interface Props {
  meta?: any;
  theme?: any;
}
const { meta = {}, theme = {} } = Astro.props;
const siteName = meta.siteName || 'Website';
const safeTheme = {
  accent: theme.accent || '#c8520e',
  ink: theme.ink || '#1c1c1c',
  cream: theme.cream || '#f5f0e8',
  sage: theme.sage || '#4a7c6f',
  accentLight: theme.accentLight || '#e2a63b',
  inkMuted: theme.inkMuted || '#5c5c5c'
};
---

<aside id="hpse-editor" class="hpse-editor" data-theme={JSON.stringify(safeTheme)} data-sitename={siteName} aria-label="Live-Editor Bearbeitungsleiste">
  <button id="hpse-editor-toggle" class="hpse-fab" type="button" aria-expanded="false" aria-controls="hpse-drawer" title="Live-Editor öffnen (Alt + E)">
    <span class="hpse-fab-icon" aria-hidden="true">⚙</span>
    <span class="hpse-fab-lbl">Editor</span>
  </button>

  <div id="hpse-drawer" class="hpse-drawer" role="dialog" aria-modal="true" aria-labelledby="hpse-drawer-title" hidden>
    <div class="hpse-drawer-head">
      <div class="hpse-head-info">
        <h2 id="hpse-drawer-title" class="hpse-title">Live-Editor</h2>
        <span class="hpse-badge">Modular</span>
      </div>
      <button id="hpse-drawer-close" class="hpse-close" type="button" aria-label="Editor schließen">×</button>
    </div>

    <div class="hpse-drawer-body">
      <!-- Bereiche mit aufklappbaren Einstellungen -->
      <div class="hpse-group">
        <div class="hpse-group-head" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="hpse-group-title" style="margin-bottom: 0;">Bereiche & Einstellungen</label>
          <div style="display: flex; gap: 8px; align-items: center;">
            <button id="hpse-open-sort-btn" type="button" class="hpse-sort-trigger-btn" title="Reihenfolge der Bereiche anpassen">
              <span class="hpse-sort-btn-icon">⇅</span>
              <span>Reihenfolge</span>
            </button>
            <button id="hpse-sections-reset" type="button" class="hpse-text-btn">Alle an</button>
          </div>
        </div>
        <p class="hpse-help" style="margin-bottom: 12px;">Klicke auf einen Bereich, um Details und Optionen aufzuklappen.</p>

        <!-- Countdown als modularer Anhang -->
        <div class="hpse-addon-box" id="hpse-addon-box">
          <div class="hpse-addon-header" id="hpse-addon-header">
            <div style="display: flex; align-items: center; gap: 8px;">
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" id="hpse-toggle-countdown" data-section="countdown" checked />
                <span class="hpse-switch"></span>
              </label>
              <div>
                <div class="hpse-addon-title">Event-Countdown</div>
                <div class="hpse-addon-subtitle">Modularer Anhang für einen beliebigen Bereich</div>
              </div>
            </div>
            <div style="display: flex; align-items: center; gap: 6px;">
              <span class="hpse-addon-badge">Anhang</span>
              <span class="hpse-addon-arrow" id="hpse-addon-arrow" aria-hidden="true">›</span>
            </div>
          </div>
          <div class="hpse-addon-body" id="hpse-cd-options" hidden>
            <div class="hpse-fields-grid" style="grid-template-columns: 1fr 1fr; gap: 10px; margin-top: 10px;">
              <div class="hpse-field">
                <label class="hpse-field-label">Anhang an Bereich:</label>
                <select id="hpse-cd-target" class="hpse-select">
                  <option value="hero" selected>Hero (Startbereich)</option>
                  <option value="about">Über uns</option>
                  <option value="services">Leistungen</option>
                  <option value="gallery">Galerie / Sortiment</option>
                  <option value="pricing">Preise</option>
                  <option value="reviews">Bewertungen</option>
                  <option value="booking">Buchung / Termin</option>
                  <option value="sponsors">Sponsoren / Partner</option>
                  <option value="hamburg-tour">Hamburg Touren</option>
                  <option value="service-erinnerung">Erinnerungs-Service</option>
                  <option value="newsletter">Newsletter</option>
                  <option value="contact">Kontakt</option>
                </select>
              </div>
              <div class="hpse-field">
                <label class="hpse-field-label">Platzierung:</label>
                <select id="hpse-cd-pos" class="hpse-select">
                  <option value="before" selected>Oberhalb des Bereichs</option>
                  <option value="after">Unterhalb des Bereichs</option>
                </select>
              </div>
            </div>
          </div>
        </div>
        
        <div class="hpse-accordion" id="hpse-accordion">
          <!-- Hero -->
          <div class="hpse-acc-item" data-acc-id="hero" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="hero" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Hero (Startbereich)</span>
            </div>
          </div>

          <!-- Über uns -->
          <div class="hpse-acc-item" data-acc-id="about" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="about" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Über uns</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-field">
                <label class="hpse-field-label">Personenanzahl & Aufbau</label>
                <select id="hpse-var-about" class="hpse-select">
                  <option value="solo">1 Person (Solo / Porträt links)</option>
                  <option value="duo" selected>2 Personen (Gründer-Duo)</option>
                  <option value="team">Team (2 Reihen, swipebar, Abteilungen)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Leistungen -->
          <div class="hpse-acc-item" data-acc-id="services" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="services" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Leistungen</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-fields-grid">
                <div class="hpse-field">
                  <label class="hpse-field-label">Spalten</label>
                  <select id="hpse-var-services-cols" class="hpse-select">
                    <option value="2">2 Spalten</option>
                    <option value="3" selected>3 Spalten</option>
                    <option value="4">4 Spalten</option>
                  </select>
                </div>
                <div class="hpse-field">
                  <label class="hpse-field-label">Zeilen</label>
                  <select id="hpse-var-services-rows" class="hpse-select">
                    <option value="1">1 Zeile</option>
                    <option value="2" selected>2 Zeilen</option>
                    <option value="3">3 Zeilen</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

<!-- Galerie / Sortiment -->
          <div class="hpse-acc-item" data-acc-id="gallery" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="gallery" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Galerie / Sortiment</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-field" style="margin-bottom: 8px;">
                <label class="hpse-field-label">Darstellung</label>
                <select id="hpse-var-gallery-mode" class="hpse-select">
                  <option value="carousel" selected>Karussell (Swipe)</option>
                  <option value="grid">Raster (Grid)</option>
                </select>
              </div>
              <div class="hpse-fields-grid" id="hpse-gal-grid-options">
                <div class="hpse-field">
                  <label class="hpse-field-label">Spalten</label>
                  <select id="hpse-var-gallery-cols" class="hpse-select">
                    <option value="2">2 Spalten</option>
                    <option value="3" selected>3 Spalten</option>
                    <option value="4">4 Spalten</option>
                  </select>
                </div>
                <div class="hpse-field">
                  <label class="hpse-field-label">Zeilen</label>
                  <select id="hpse-var-gallery-rows" class="hpse-select">
                    <option value="1">1 Zeile</option>
                    <option value="2" selected>2 Zeilen</option>
                    <option value="3">3 Zeilen</option>
                    <option value="all">Alle</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Preise -->
          <div class="hpse-acc-item" data-acc-id="pricing" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="pricing" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Preise</span>
            </div>
          </div>

<!-- Bewertungen -->
          <div class="hpse-acc-item" data-acc-id="reviews" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="reviews" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Bewertungen</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-field" style="margin-bottom: 8px;">
                <label class="hpse-field-label">Darstellung</label>
                <select id="hpse-var-reviews-mode" class="hpse-select">
                  <option value="carousel" selected>Karussell (Swipe)</option>
                  <option value="grid">Raster (Grid)</option>
                </select>
              </div>
              <div class="hpse-fields-grid" id="hpse-rev-grid-options">
                <div class="hpse-field">
                  <label class="hpse-field-label">Spalten</label>
                  <select id="hpse-var-reviews-cols" class="hpse-select">
                    <option value="2">2 Spalten</option>
                    <option value="3" selected>3 Spalten</option>
                    <option value="4">4 Spalten</option>
                  </select>
                </div>
                <div class="hpse-field">
                  <label class="hpse-field-label">Zeilen</label>
                  <select id="hpse-var-reviews-rows" class="hpse-select">
                    <option value="1" selected>1 Zeile</option>
                    <option value="2">2 Zeilen</option>
                    <option value="all">Alle</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Buchung -->
          <div class="hpse-acc-item" data-acc-id="booking" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="booking" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Buchung / Termin</span>
            </div>
          </div>

          <!-- Sponsoren -->
          <div class="hpse-acc-item" data-acc-id="sponsors" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="sponsors" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Sponsoren / Partner</span>
            </div>
          </div>

          <!-- Hamburg Touren -->
          <div class="hpse-acc-item" data-acc-id="hamburg-tour" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="hamburg-tour" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Hamburg Touren</span>
            </div>
          </div>

          <!-- Erinnerungs-Service -->
          <div class="hpse-acc-item" data-acc-id="service-erinnerung" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="service-erinnerung" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Erinnerungs-Service</span>
            </div>
          </div>

          <!-- Newsletter -->
          <div class="hpse-acc-item" data-acc-id="newsletter" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="newsletter" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Newsletter</span>
            </div>
          </div>

          <!-- Kontakt -->
          <div class="hpse-acc-item" data-acc-id="contact" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="contact" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Kontakt</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="hpse-acc-item" data-acc-id="footer" draggable="true">
            <div class="hpse-acc-header">
              <span class="hpse-acc-drag-handle" title="Ziehen zum Verschieben">⠿</span>
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="footer" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Footer</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Export & Reset -->
      <!-- Gestaltungs-Optionen: Farbpalette & Typografie (eingeklappt) -->
      <div class="hpse-group">
        <label class="hpse-group-title">Design & Typografie</label>
        <div class="hpse-accordion">
          <!-- Farbpalette eingeklappt -->
          <details class="hpse-acc-item" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; overflow: hidden;">
            <summary style="padding: 10px 14px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: space-between; list-style: none; user-select: none;">
              <span style="display: flex; align-items: center; gap: 6px;">
                <span>🎨 Marken-Farbpalette</span>
                <span style="font-size: 0.68rem; color: #9ca3af; font-weight: 400;">({siteName})</span>
              </span>
              <span style="font-size: 0.75rem; color: #9ca3af;">▼</span>
            </summary>
            <div style="padding: 10px 14px 14px; border-top: 1px solid rgba(255,255,255,0.06);">
              <!-- Übersicht der aktiven Farbwerte -->
              <div style="display: flex; flex-direction: column; gap: 6px; margin-bottom: 12px; background: rgba(0,0,0,0.25); border-radius: 6px; padding: 8px 10px; border: 1px solid rgba(255,255,255,0.06); font-size: 0.75rem;">
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-accent" style="width: 10px; height: 10px; border-radius: 50%; background: #c8520e; display: inline-block;"></span> 1. Pixel-Orange (Akzent)</span>
                  <span id="hpse-val-accent" style="font-family: monospace; color: #9ca3af;">#c8520e</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-ink" style="width: 10px; height: 10px; border-radius: 50%; background: #1c1c1c; border: 1px solid rgba(255,255,255,0.3); display: inline-block;"></span> 2. Dunkles Ink (Hintergrund)</span>
                  <span id="hpse-val-ink" style="font-family: monospace; color: #9ca3af;">#1c1c1c</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-cream" style="width: 10px; height: 10px; border-radius: 50%; background: #f5f0e8; border: 1px solid rgba(255,255,255,0.3); display: inline-block;"></span> 3. Warm-Creme (Text/Flächen)</span>
                  <span id="hpse-val-cream" style="font-family: monospace; color: #9ca3af;">#f5f0e8</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-sage" style="width: 10px; height: 10px; border-radius: 50%; background: #4a7c6f; display: inline-block;"></span> 4. Salbei-Grün (Akzent)</span>
                  <span id="hpse-val-sage" style="font-family: monospace; color: #9ca3af;">#4a7c6f</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-accentLight" style="width: 10px; height: 10px; border-radius: 50%; background: #e2a63b; display: inline-block;"></span> 5. Gold (Highlights)</span>
                  <span id="hpse-val-accentLight" style="font-family: monospace; color: #9ca3af;">#e2a63b</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center;">
                  <span style="display: flex; align-items: center; gap: 6px;"><span id="hpse-dot-inkMuted" style="width: 10px; height: 10px; border-radius: 50%; background: #5c5c5c; display: inline-block;"></span> 6. Schiefer-Grau (Dezent)</span>
                  <span id="hpse-val-inkMuted" style="font-family: monospace; color: #9ca3af;">#5c5c5c</span>
                </div>
              </div>

              <!-- Interaktive Color-Picker -->
              <label style="display: block; font-size: 0.72rem; font-weight: 700; color: #9ca3af; text-transform: uppercase; margin-bottom: 6px;">Farbtöne anpassen</label>
              <div class="hpse-color-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 8px;">
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Pixel-Orange</span>
                  <input type="color" id="hpse-col-accent" value="#c8520e" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Dunkles Ink</span>
                  <input type="color" id="hpse-col-ink" value="#1c1c1c" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Warm-Creme</span>
                  <input type="color" id="hpse-col-cream" value="#f5f0e8" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Salbei-Grün</span>
                  <input type="color" id="hpse-col-sage" value="#4a7c6f" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Highlight-Gold</span>
                  <input type="color" id="hpse-col-accentLight" value="#e2a63b" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
                <label style="font-size: 0.75rem; display: flex; flex-direction: column; gap: 4px;">
                  <span>Schiefer-Grau</span>
                  <input type="color" id="hpse-col-inkMuted" value="#5c5c5c" style="width: 100%; height: 32px; border-radius: 6px; border: 1px solid rgba(255,255,255,0.2); background: transparent; cursor: pointer;" />
                </label>
              </div>
            </div>
          </details>

          <!-- Schriftart & Schriftgröße zusammen eingeklappt -->
          <details class="hpse-acc-item" style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; overflow: hidden; margin-top: 6px;">
            <summary style="padding: 10px 14px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; justify-content: space-between; list-style: none; user-select: none;">
              <span>🔤 Schriftart & Schriftgrößen</span>
              <span style="font-size: 0.75rem; color: #9ca3af;">▼</span>
            </summary>
            <div style="padding: 10px 14px 14px; border-top: 1px solid rgba(255,255,255,0.06); display: flex; flex-direction: column; gap: 12px;">
              <div>
                <label style="display: block; font-size: 0.75rem; font-weight: 600; color: #9ca3af; margin-bottom: 4px;" for="hpse-font-pair">Schrift-Kombination</label>
                <select id="hpse-font-pair" style="width: 100%; padding: 6px 8px; border-radius: 6px; background: #1f2937; color: #fff; border: 1px solid rgba(255,255,255,0.15); font-size: 0.8rem;">
                  <option value="dm-outfit">DM Serif Display + Outfit (Standard pixel&amp;code)</option>
                  <option value="playfair-inter">Playfair Display + Inter (Klassisch Elegant)</option>
