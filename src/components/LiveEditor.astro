  /* 1 Person im Team: Exakt wie Single (großformatig, Foto links 540px, Text rechts zentriert) */
  :global(.about-team-track[data-visible-count="1"]) {
    grid-template-rows: 1fr !important;
    grid-template-columns: 1fr !important;
