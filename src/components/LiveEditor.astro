  :global(.about-team-track[data-visible-count="2"] .team-card) {
    height: 640px !important;
    flex-direction: column !important;
  }
  :global(#about .about-team-track[data-visible-count="2"] .team-card .aphoto) {
    flex: 1 1 0 !important;
    width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    aspect-ratio: unset !important;
    border-top-left-radius: inherit !important;
    border-top-right-radius: inherit !important;
    border-bottom-left-radius: 0 !important;
    border-bottom-right-radius: 0 !important;
  }
  :global(#about .about-team-track[data-visible-count="2"] .team-card .abody) {
    flex: 0 0 auto !important;
    padding: 1.1rem 1.4rem 1.4rem !important;
    border-bottom-left-radius: inherit !important;
    border-bottom-right-radius: inherit !important;
    border-top-right-radius: 0 !important;
