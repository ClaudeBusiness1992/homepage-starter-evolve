    :global(body.hpse-about-solo #about-default-grid .aphoto) { flex: 0 0 auto !important; width: 100% !important; height: auto !important; min-height: 0 !important; aspect-ratio: 1 / 1 !important; }
  }

  /* ═══ Team-Modus: feste Header-Position & dynamische Kachelgrößen je Personenzahl ═══ */
