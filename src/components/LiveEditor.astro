---
/* LiveEditor.astro — Modulare Bearbeitungsleiste mit Accordion & Darstellungsoptionen */
---

<aside id="hpse-editor" class="hpse-editor" aria-label="Live-Editor Bearbeitungsleiste">
  <button id="hpse-editor-toggle" class="hpse-fab" type="button" aria-expanded="false" aria-controls="hpse-drawer" title="Live-Editor öffnen (Alt + E)">
    <span class="hpse-fab-icon" aria-hidden="true">⚙</span>
    <span class="hpse-fab-lbl">Editor</span>
  </button>

  <div id="hpse-drawer" class="hpse-drawer" role="dialog" aria-modal="true" aria-labelledby="hpse-drawer-title" hidden>
    <div class="hpse-drawer-head">
      <div class="hpse-head-info">
        <h2 id="hpse-drawer-title" class="hpse-title">Live-Editor</h2>
        <span class="hpse-badge">Modular</span>
      </div>
      <button id="hpse-drawer-close" class="hpse-close" type="button" aria-label="Editor schließen">×</button>
    </div>

    <div class="hpse-drawer-body">
      <!-- Bereiche mit aufklappbaren Einstellungen -->
      <div class="hpse-group">
        <div class="hpse-group-head">
          <label class="hpse-group-title">Bereiche & Einstellungen</label>
          <button id="hpse-sections-reset" type="button" class="hpse-text-btn">Alle an</button>
        </div>
        <p class="hpse-help">Klicke auf einen Bereich, um Details und Optionen aufzuklappen.</p>
        
        <div class="hpse-accordion" id="hpse-accordion">
          <!-- Countdown -->
          <div class="hpse-acc-item" data-acc-id="countdown">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="countdown" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Event-Countdown</span>
            </div>
          </div>

          <!-- Hero -->
          <div class="hpse-acc-item" data-acc-id="hero">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="hero" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Hero (Startbereich)</span>
            </div>
          </div>

          <!-- Über uns -->
          <div class="hpse-acc-item" data-acc-id="about">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="about" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Über uns</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-field">
                <label class="hpse-field-label">Personenanzahl & Aufbau</label>
                <select id="hpse-var-about" class="hpse-select">
                  <option value="solo">1 Person (Solo / Porträt links)</option>
                  <option value="duo" selected>2 Personen (Gründer-Duo)</option>
                  <option value="team">Team (2 Reihen, swipebar, Abteilungen)</option>
                </select>
              </div>
            </div>
          </div>

          <!-- Leistungen -->
          <div class="hpse-acc-item" data-acc-id="services">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label" onclick="event.stopPropagation()">
                <input type="checkbox" data-section="services" checked />
                <span class="hpse-switch"></span>
              </label>
              <button type="button" class="hpse-acc-trigger" aria-expanded="false">
                <span class="hpse-acc-title">Leistungen</span>
                <span class="hpse-acc-arrow">›</span>
              </button>
            </div>
            <div class="hpse-acc-content" hidden>
              <div class="hpse-fields-grid">
                <div class="hpse-field">
                  <label class="hpse-field-label">Spalten</label>
                  <select id="hpse-var-services-cols" class="hpse-select">
                    <option value="2">2 Spalten</option>
                    <option value="3" selected>3 Spalten</option>
                    <option value="4">4 Spalten</option>
                  </select>
                </div>
                <div class="hpse-field">
                  <label class="hpse-field-label">Zeilen</label>
                  <select id="hpse-var-services-rows" class="hpse-select">
                    <option value="1">1 Zeile</option>
                    <option value="2" selected>2 Zeilen</option>
                    <option value="3">3 Zeilen</option>
                  </select>
                </div>
              </div>
            </div>
          </div>

          <!-- Galerie -->
          <div class="hpse-acc-item" data-acc-id="gallery">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="gallery" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Galerie / Sortiment</span>
            </div>
          </div>

          <!-- Preise -->
          <div class="hpse-acc-item" data-acc-id="pricing">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="pricing" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Preise</span>
            </div>
          </div>

          <!-- Bewertungen -->
          <div class="hpse-acc-item" data-acc-id="reviews">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="reviews" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Bewertungen</span>
            </div>
          </div>

          <!-- Buchung -->
          <div class="hpse-acc-item" data-acc-id="booking">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="booking" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Buchung / Termin</span>
            </div>
          </div>

          <!-- Sponsoren -->
          <div class="hpse-acc-item" data-acc-id="sponsors">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="sponsors" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Sponsoren / Partner</span>
            </div>
          </div>

          <!-- Kontakt -->
          <div class="hpse-acc-item" data-acc-id="contact">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="contact" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Kontakt</span>
            </div>
          </div>

          <!-- Footer -->
          <div class="hpse-acc-item" data-acc-id="footer">
            <div class="hpse-acc-header">
              <label class="hpse-toggle-label">
                <input type="checkbox" data-section="footer" checked />
                <span class="hpse-switch"></span>
              </label>
              <span class="hpse-acc-title">Footer</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Export & Reset -->
      <div class="hpse-group">
        <label class="hpse-group-title">Konfiguration</label>
        <div class="hpse-action-row">
          <button id="hpse-export-btn" type="button" class="btn btn-ghost hpse-btn-sm">JSON exportieren</button>
          <button id="hpse-reset-btn" type="button" class="btn btn-ghost hpse-btn-sm">Zurücksetzen</button>
        </div>
        <p id="hpse-export-feedback" class="hpse-feedback" aria-live="polite"></p>
      </div>
    </div>
  </div>
</aside>

<style>
  /* FAB */
  .hpse-editor {
    position: relative;
    z-index: 9999;
    font-family: var(--sans, system-ui, -apple-system, sans-serif);
  }
  .hpse-fab {
    position: fixed;
    top: 50%;
    left: 0;
    transform: translateY(-50%);
    background: #111827;
    color: #f9fafb;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-left: none;
    border-radius: 0 16px 16px 0;
    padding: 14px 18px 14px 14px;
    box-shadow: 0 8px 28px rgba(0, 0, 0, 0.45);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), background 0.2s ease, padding 0.2s ease;
  }
  .hpse-fab:hover { background: #1f2937; padding-left: 18px; }
  .hpse-fab-icon { font-size: var(--fs-lg); line-height: 1; color: var(--accent-light, #ea580c); }
  .hpse-fab-lbl { font-size: var(--fs-sm); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }

  /* Drawer */
  .hpse-drawer {
    position: fixed;
    top: 0;
    left: 0;
    bottom: 0;
    width: 330px;
    max-width: 90vw;
    background: rgba(17, 24, 39, 0.96);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-right: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 16px 0 36px rgba(0, 0, 0, 0.5);
    display: flex;
    flex-direction: column;
    transform: translateX(-100%);
    transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
    color: #f3f4f6;
  }
  .hpse-drawer.is-open { transform: translateX(0); }
  .hpse-drawer-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18px 20px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }
  .hpse-head-info { display: flex; align-items: center; gap: 8px; }
  .hpse-title { font-size: 1.1rem; font-weight: 700; color: #fff; margin: 0; }
  .hpse-badge { font-size: 0.65rem; font-weight: 700; padding: 2px 7px; border-radius: 999px; background: var(--accent, #ea580c); color: #fff; text-transform: uppercase; letter-spacing: 0.05em; }
  .hpse-close { background: transparent; border: none; color: #9ca3af; font-size: 1.6rem; line-height: 1; cursor: pointer; padding: 2px 6px; border-radius: 6px; }
  .hpse-close:hover { color: #fff; background: rgba(255, 255, 255, 0.1); }
  .hpse-drawer-body {
    padding: 18px;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 20px;
    flex: 1;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .hpse-drawer-body::-webkit-scrollbar {
    display: none;
    width: 0;
    height: 0;
  }
  .hpse-group { display: flex; flex-direction: column; gap: 8px; }
  .hpse-group-head { display: flex; align-items: center; justify-content: space-between; }
  .hpse-group-title { font-size: 0.82rem; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #9ca3af; }
  .hpse-help { font-size: 0.74rem; color: #6b7280; line-height: 1.4; margin: 0; }

  /* Accordion */
  .hpse-accordion { display: flex; flex-direction: column; gap: 8px; margin-top: 4px; }
  .hpse-acc-item {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 8px;
    overflow: hidden;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .hpse-acc-item:hover { background: rgba(255, 255, 255, 0.05); }
  .hpse-acc-item.is-expanded { border-color: rgba(255, 255, 255, 0.18); background: rgba(255, 255, 255, 0.04); }
  
  .hpse-acc-header {
    display: flex;
    align-items: center;
    padding: 10px 14px;
    gap: 12px;
    min-height: 44px;
    box-sizing: border-box;
  }
  .hpse-toggle-label {
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .hpse-toggle-label input { position: absolute; opacity: 0; pointer-events: none; }
  .hpse-switch {
    position: relative;
    width: 32px;
    height: 18px;
    background: #374151;
    border-radius: 999px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }
  .hpse-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 14px;
    height: 14px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hpse-toggle-label input:checked + .hpse-switch { background: var(--accent, #ea580c); }
  .hpse-toggle-label input:checked + .hpse-switch::after { transform: translateX(14px); }

  .hpse-acc-trigger {
    background: transparent;
    border: none;
    color: #e5e7eb;
    font-family: inherit;
    font-size: 0.85rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    padding: 0;
    cursor: pointer;
    text-align: left;
    height: 100%;
  }
  .hpse-acc-title {
    font-family: inherit;
    font-size: 0.85rem !important;
    font-weight: 600;
    color: #e5e7eb;
    line-height: 1.2;
    display: flex;
    align-items: center;
    flex: 1;
  }
  .hpse-acc-arrow {
    font-size: 1.1rem;
    color: #9ca3af;
    transition: transform 0.2s ease;
    line-height: 1;
  }
  .hpse-acc-item.is-expanded .hpse-acc-arrow {
    transform: rotate(90deg);
    color: var(--accent-light, #ea580c);
  }

  .hpse-acc-content {
    padding: 12px 14px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.2);
  }
  .hpse-sub-help { font-size: 0.75rem; color: #9ca3af; margin: 0; }

  .hpse-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .hpse-field { display: flex; flex-direction: column; gap: 5px; }
  .hpse-field-label { font-size: 0.75rem; font-weight: 600; color: #d1d5db; }
  .hpse-select {
    background: #1f2937;
    color: #f3f4f6;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 0.78rem;
    cursor: pointer;
    outline: none;
    width: 100%;
  }
  .hpse-select:focus { border-color: var(--accent, #ea580c); }

  /* Actions */
  .hpse-action-row { display: flex; gap: 8px; }
  .hpse-btn-sm {
    padding: 0 12px !important;
    font-size: 0.76rem !important;
    flex: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #e5e7eb !important;
    line-height: normal !important;
    height: 38px !important;
    min-height: 38px !important;
    max-height: 38px !important;
    box-sizing: border-box !important;
    margin: 0 !important;
  }
  .hpse-btn-sm:hover { border-color: var(--accent, #ea580c); color: #fff; }
  .hpse-text-btn { background: transparent; border: none; color: var(--accent-light, #ea580c); font-size: 0.72rem; font-weight: 600; cursor: pointer; padding: 0; }
  .hpse-text-btn:hover { text-decoration: underline; }
  .hpse-feedback { font-size: 0.72rem; color: #10b981; margin: 4px 0 0; min-height: 1rem; }

  /* Ausblendungen */
  :global([data-hpse-hidden="true"]) { display: none !important; }
  :global(.nav-ul a[data-hpse-nav-hidden="true"]) { display: none !important; }

  /* Wenn eine Sektion zur obersten sichtbaren Sektion wird (z. B. wenn Hero & Countdown aus sind):
     bündig unter der fixierten Navigation platzieren und Inhalt vertikal mittig zentrieren */
  :global(#main > section.hpse-first-visible) {
    padding-top: var(--nav-h) !important;
    height: 100dvh !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }
  :global(#main > section.hpse-first-visible > .wrap) {
    margin-block: auto !important;
    flex: 0 1 auto !important;
  }

  /* ═══ Headlines dynamisch nach Modus (Solo / Duo / Team) ═══ */
  :global(body.hpse-about-solo #about .about-headline-solo),
  :global(body.hpse-about-solo #about .about-subline-solo) {
    display: block !important;
  }
  :global(body.hpse-about-solo #about .about-headline-duo),
  :global(body.hpse-about-solo #about .about-subline-duo),
  :global(body.hpse-about-solo #about .about-headline-team),
  :global(body.hpse-about-solo #about .about-subline-team) {
    display: none !important;
  }

  :global(body.hpse-about-team #about .about-headline-team),
  :global(body.hpse-about-team #about .about-subline-team) {
    display: block !important;
  }
  :global(body.hpse-about-team #about .about-headline-duo),
  :global(body.hpse-about-team #about .about-subline-duo),
  :global(body.hpse-about-team #about .about-headline-solo),
  :global(body.hpse-about-team #about .about-subline-solo) {
    display: none !important;
  }

  :global(body.hpse-about-duo #about .about-headline-duo),
  :global(body.hpse-about-duo #about .about-subline-duo) {
    display: block !important;
  }
  :global(body.hpse-about-duo #about .about-headline-solo),
  :global(body.hpse-about-duo #about .about-subline-solo),
  :global(body.hpse-about-duo #about .about-headline-team),
  :global(body.hpse-about-duo #about .about-subline-team) {
    display: none !important;
  }

  /* ═══ 1 Person (Solo) sauber zentriert & großzügig proportional abschließend ═══ */
  :global(body.hpse-about-solo #about-default-grid) {
    display: flex !important;
    justify-content: center !important;
    max-width: 980px !important;
    margin-inline: auto !important;
  }
  :global(body.hpse-about-solo #about-default-grid .acard:nth-child(n+2)) {
    display: none !important;
  }
  :global(body.hpse-about-solo #about-default-grid .acard) {
    display: flex !important;
    flex-direction: row !important;
    align-items: stretch !important;
    width: 100% !important;
    max-width: 980px !important;
    height: 640px !important;
    min-height: 640px !important;
    background: var(--bg-card) !important;
    border-radius: var(--r-lg) !important;
    overflow: hidden !important;
  }
  :global(body.hpse-about-solo #about-default-grid .aphoto) {
    flex: 0 0 540px !important;
    width: 540px !important;
    height: 100% !important;
    min-height: 640px !important;
    max-height: none !important;
    margin: 0 !important;
    padding: 0 !important;
    border-radius: 0 !important;
  }

  /* ═══ 2 Personen (Duo) harmonisiert auf 640px Kachelhöhe ═══ */
  :global(body.hpse-about-duo #about-default-grid) {
    max-height: 640px !important;
  }
  :global(body.hpse-about-duo #about-default-grid .acard) {
    height: 640px !important;
    max-height: 640px !important;
  }
  :global(body.hpse-about-solo #about-default-grid .aphoto img) {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    object-position: center 20% !important;
    display: block !important;
  }
  :global(body.hpse-about-solo #about-default-grid .abody) {
    padding: 3rem 2.5rem !important;
    flex: 1 !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }
  :global(body.hpse-about-solo #about-default-grid .aname) {
    font-size: clamp(1.8rem, 2.5vw, 2.4rem) !important;
    margin-bottom: 0.35rem !important;
  }
  :global(body.hpse-about-solo #about-default-grid .arole) {
    font-size: var(--fs-md) !important;
    margin-bottom: 1.25rem !important;
  }
  :global(body.hpse-about-solo #about-default-grid .atext) {
    font-size: var(--fs-md) !important;
    line-height: 1.65 !important;
  }
  @media (max-width: 760px) {
    :global(body.hpse-about-solo #about-default-grid .acard) { flex-direction: column !important; height: auto !important; min-height: 0 !important; }
    :global(body.hpse-about-solo #about-default-grid .aphoto) { flex: 0 0 auto !important; width: 100% !important; height: auto !important; min-height: 0 !important; aspect-ratio: 1 / 1 !important; }
  }

  /* ═══ Team-Modus: feste Header-Position & dynamische Kachelgrößen je Personenzahl ═══ */
  :global(body.hpse-about-team #about-default-grid) { display: none !important; }
  :global(body.hpse-about-team #about) {
    height: 100dvh !important;
    max-height: 100dvh !important;
    padding-top: var(--nav-h) !important;
    padding-bottom: 1.5rem !important;
    justify-content: flex-start !important;
    box-sizing: border-box !important;
  }
  :global(body.hpse-about-team #about > .wrap) {
    display: flex !important;
    flex-direction: column !important;
    height: 100% !important;
    flex: 1 !important;
    min-height: 0 !important;
    margin-block: 0 !important;
    justify-content: flex-start !important;
  }
  :global(body.hpse-about-team #about .section-hd) {
    flex-shrink: 0 !important;
    margin-bottom: 0.75rem !important;
  }
  :global(body.hpse-about-team #about #about-dept-filters) {
    display: flex !important;
    flex-shrink: 0 !important;
    margin-bottom: 1.25rem !important;
  }
  :global(body.hpse-about-team #about-team-carousel) {
    display: flex !important;
    flex-direction: column !important;
    justify-content: flex-start !important;
    flex: 1 !important;
    min-height: 0 !important;
  }

  :global(.about-depts) {
    display: none !important;
    justify-content: center;
    gap: 8px;
    margin-bottom: 1.25rem;
    flex-wrap: wrap;
  }
  :global(body.hpse-about-team .about-depts) {
    display: flex !important;
  }
  :global(.about-dept-btn) {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid var(--border-subtle);
    color: var(--cream);
    padding: 6px 14px;
    border-radius: 999px;
    font-size: var(--fs-sm) !important;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  :global(.about-dept-btn:hover) {
    background: rgba(255, 255, 255, 0.1);
