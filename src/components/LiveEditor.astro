  .hpse-sort-list {
    flex: 1;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding-right: 4px;
    scrollbar-width: thin;
  }
  .hpse-sort-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 9px 12px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 8px;
    cursor: grab;
    user-select: none;
    transition: background 0.12s ease, border-color 0.12s ease;
  }
  .hpse-sort-card:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(255, 255, 255, 0.2);
  }
  .hpse-sort-card.is-dragging {
    opacity: 0.35;
    background: rgba(200, 82, 14, 0.1);
    border: 1px dashed var(--accent, #c8520e);
  }
  .hpse-sort-card-left {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .hpse-sort-handle {
    font-size: 1.15rem;
    color: #6b7280;
    cursor: grab;
    line-height: 1;
  }
  .hpse-sort-num {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--accent-light, #ea580c);
    background: rgba(200, 82, 14, 0.15);
    padding: 2px 6px;
    border-radius: 4px;
    min-width: 20px;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }
  .hpse-sort-icon { font-size: 1rem; line-height: 1; }
  .hpse-sort-name { font-size: 0.85rem; font-weight: 600; color: #e5e7eb; }
  .hpse-sort-badge-off {
    font-size: 0.65rem;
    color: #9ca3af;
    background: rgba(255, 255, 255, 0.06);
    padding: 1px 5px;
    border-radius: 4px;
  }
  .hpse-sort-card-right {
    display: flex;
    align-items: center;
    gap: 4px;
  }
  .hpse-sort-btn {
    width: 26px;
    height: 26px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    color: #d1d5db;
    cursor: pointer;
    font-size: 0.7rem;
    transition: background 0.12s ease, color 0.12s ease, border-color 0.12s ease;
  }
  .hpse-sort-btn:hover:not(:disabled) {
    background: var(--accent, #c8520e);
    color: #fff;
    border-color: var(--accent, #c8520e);
  }
  .hpse-sort-btn:disabled {
    opacity: 0.2;
    cursor: not-allowed;
  }
  .hpse-drop-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 10px;
    background: color-mix(in srgb, var(--accent, #c8520e) 15%, transparent);
    border: 2px dashed var(--accent, #c8520e);
    border-radius: 8px;
    color: var(--accent-light, #ea580c);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    pointer-events: none;
    animation: hpse-pulse 1.2s ease-in-out infinite;
  }
  @keyframes hpse-pulse {
    0%, 100% { opacity: 0.8; transform: scale(1); }
    50% { opacity: 1; transform: scale(1.01); }
  }
  .hpse-sort-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 14px;
  }
  .hpse-toggle-label {
    display: flex;
    align-items: center;
    cursor: pointer;
    flex-shrink: 0;
  }
  .hpse-toggle-label input { position: absolute; opacity: 0; pointer-events: none; }
  .hpse-switch {
    position: relative;
    width: 28px;
    height: 16px;
    background: #374151;
    border-radius: 999px;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }
  .hpse-switch::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .hpse-toggle-label input:checked + .hpse-switch { background: var(--accent, #ea580c); }
  .hpse-toggle-label input:checked + .hpse-switch::after { transform: translateX(12px); }

  .hpse-acc-trigger {
    background: transparent;
    border: none;
    color: #e5e7eb;
    font-family: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: 1;
    padding: 0;
    cursor: pointer;
    text-align: left;
    height: 100%;
  }
  .hpse-acc-title {
    font-family: inherit;
    font-size: 0.8125rem !important;
    font-weight: 600;
    color: #e5e7eb;
    line-height: 1.2;
    display: flex;
    align-items: center;
    flex: 1;
  }
  .hpse-acc-arrow {
    font-size: 1rem;
    color: #9ca3af;
    transition: transform 0.2s ease;
    line-height: 1;
  }
  .hpse-acc-item.is-expanded .hpse-acc-arrow {
    transform: rotate(90deg);
    color: var(--accent-light, #ea580c);
  }

  .hpse-acc-content {
    padding: 12px 14px 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    background: rgba(0, 0, 0, 0.2);
  }
  .hpse-sub-help { font-size: 0.75rem; color: #9ca3af; margin: 0; }

  .hpse-fields-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .hpse-field { display: flex; flex-direction: column; gap: 5px; }
  .hpse-field-label { font-size: 0.75rem; font-weight: 600; color: #d1d5db; }
  .hpse-select {
    background: #1f2937;
    color: #f3f4f6;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 0.78rem;
    cursor: pointer;
    outline: none;
    width: 100%;
  }
  .hpse-select:focus { border-color: var(--accent, #ea580c); }

  /* Actions */
  .hpse-action-row { display: flex; gap: 8px; }
  .hpse-btn-sm {
    padding: 0 12px !important;
    font-size: 0.76rem !important;
    flex: 1 !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    text-align: center !important;
    border-color: rgba(255, 255, 255, 0.15) !important;
    color: #e5e7eb !important;
    line-height: normal !important;
    height: 38px !important;
    min-height: 38px !important;
    max-height: 38px !important;
    box-sizing: border-box !important;
    margin: 0 !important;
  }
  .hpse-btn-sm:hover { border-color: var(--accent, #ea580c); color: #fff; }
  .hpse-text-btn { background: transparent; border: none; color: var(--accent-light, #ea580c); font-size: 0.72rem; font-weight: 600; cursor: pointer; padding: 0; }
  .hpse-text-btn:hover { text-decoration: underline; }
  .hpse-feedback { font-size: 0.72rem; color: #10b981; margin: 4px 0 0; min-height: 1rem; }

  /* Ausblendungen */
  :global([data-hpse-hidden="true"]) { display: none !important; }
  :global(.nav-ul a[data-hpse-nav-hidden="true"]) { display: none !important; }

  /* Wenn eine Sektion zur obersten sichtbaren Sektion wird (z. B. wenn Hero & Countdown aus sind):
     bündig unter der fixierten Navigation platzieren und Inhalt vertikal mittig zentrieren */
  :global(#main > section.hpse-first-visible) {
    padding-top: var(--nav-h) !important;
    height: 100dvh !important;
    box-sizing: border-box !important;
    display: flex !important;
    flex-direction: column !important;
    justify-content: center !important;
  }
  :global(#main > section.hpse-first-visible > .wrap) {
    margin-block: auto !important;
    flex: 0 1 auto !important;
  }

  /* ═══ Headlines dynamisch nach Modus (Solo / Duo / Team) ═══ */
  :global(body.hpse-about-solo #about .about-headline-solo),
  :global(body.hpse-about-solo #about .about-subline-solo) {
    display: block !important;
  }
  :global(body.hpse-about-solo #about .about-headline-duo),
  :global(body.hpse-about-solo #about .about-subline-duo),
  :global(body.hpse-about-solo #about .about-headline-team),
  :global(body.hpse-about-solo #about .about-subline-team) {
    display: none !important;
  }

  :global(body.hpse-about-team #about .about-headline-team),
  :global(body.hpse-about-team #about .about-subline-team) {
    display: block !important;
  }
  :global(body.hpse-about-team #about .about-headline-duo),
  :global(body.hpse-about-team #about .about-subline-duo),
  :global(body.hpse-about-team #about .about-headline-solo),
  :global(body.hpse-about-team #about .about-subline-solo) {
    display: none !important;
  }

  :global(body.hpse-about-duo #about .about-headline-duo),
  :global(body.hpse-about-duo #about .about-subline-duo) {
    display: block !important;
  }
  :global(body.hpse-about-duo #about .about-headline-solo),
  :global(body.hpse-about-duo #about .about-subline-solo),
  :global(body.hpse-about-duo #about .about-headline-team),
  :global(body.hpse-about-duo #about .about-subline-team) {
    display: none !important;
  }

  /* ═══ 1 Person (Solo) sauber zentriert & großzügig proportional abschließend ═══ */
  :global(body.hpse-about-solo #about-default-grid) {
    display: flex !important;
    justify-content: center !important;
    max-width: 980px !important;
    margin-inline: auto !important;
