<script is:inline>
(() => {
  const STORAGE_KEY = 'hpse_editor_accordion_v3';
  const fab = document.getElementById('hpse-editor-toggle');
  const drawer = document.getElementById('hpse-drawer');
  const closeBtn = document.getElementById('hpse-drawer-close');
  const accordion = document.getElementById('hpse-accordion');
  const resetBtn = document.getElementById('hpse-reset-btn');
  const sectionsResetBtn = document.getElementById('hpse-sections-reset');
  const exportBtn = document.getElementById('hpse-export-btn');
  const feedback = document.getElementById('hpse-export-feedback');

  const aboutSelect = document.getElementById('hpse-var-about');
  const srvColsSelect = document.getElementById('hpse-var-services-cols');
  const srvRowsSelect = document.getElementById('hpse-var-services-rows');
  const galModeSelect = document.getElementById('hpse-var-gallery-mode');
  const galColsSelect = document.getElementById('hpse-var-gallery-cols');
  const galRowsSelect = document.getElementById('hpse-var-gallery-rows');
  const galGridOpts = document.getElementById('hpse-gallery-grid-opts');

  if (!fab || !drawer) return;

  const fontPairs = {
    'dm-outfit': { serif: "'DM Serif Display', Georgia, serif", sans: "'Outfit', system-ui, sans-serif" },
    'playfair-inter': { serif: "'Playfair Display', Georgia, serif", sans: "'Inter', system-ui, sans-serif" },
    'cinzel-plus': { serif: "'Cinzel', Georgia, serif", sans: "'Plus Jakarta Sans', system-ui, sans-serif" },
    'syne-space': { serif: "'Syne', Georgia, serif", sans: "'Space Grotesk', system-ui, sans-serif" },
    'fraunces-urban': { serif: "'Fraunces', Georgia, serif", sans: "'Urbanist', system-ui, sans-serif" },
    'sans-only': { serif: "'Outfit', system-ui, sans-serif", sans: "'Outfit', system-ui, sans-serif" }
  };

  const fontScales = {
    compact: { xl: '3.1rem', lg: '1.35rem', md: '1rem', base: '0.85rem', sm: '0.7rem' },
    normal:  { xl: '3.5rem', lg: '1.5rem',  md: '1.125rem', base: '0.9375rem', sm: '0.75rem' },
    large:   { xl: '4.0rem', lg: '1.7rem',  md: '1.25rem', base: '1.05rem', sm: '0.82rem' },
    xlarge:  { xl: '4.5rem', lg: '1.9rem',  md: '1.35rem', base: '1.15rem', sm: '0.9rem' }
  };

  const defaultTypography = {
    fontPair: 'dm-outfit',
    scale: 'normal'
  };

  const editorEl = document.getElementById('hpse-editor');
  let serverTheme = {};
  try {
    serverTheme = editorEl?.dataset?.theme ? JSON.parse(editorEl.dataset.theme) : {};
  } catch (e) {}

  const defaultColors = {
    accent: serverTheme.accent || '#c8520e',
    ink: serverTheme.ink || '#1c1c1c',
    cream: serverTheme.cream || '#f5f0e8',
    sage: serverTheme.sage || '#4a7c6f',
    accentLight: serverTheme.accentLight || '#e2a63b',
    inkMuted: serverTheme.inkMuted || '#5c5c5c'
  };

  const defaultOrder = [
    'hero',
    'about',
    'services',
    'gallery',
    'pricing',
    'reviews',
    'booking',
    'sponsors',
    'hamburg-tour',
    'service-erinnerung',
    'newsletter',
    'contact',
    'footer'
  ];

  const defaultState = {
    colors: { ...defaultColors },
    typography: { ...defaultTypography },
    order: [ ...defaultOrder ],
    countdown: {
      target: 'hero',
      position: 'before'
    },
    sections: {
      countdown: true,
      hero: true,
      about: true,
      services: true,
      gallery: true,
      pricing: true,
      reviews: true,
      booking: true,
      sponsors: true,
      'hamburg-tour': true,
      'service-erinnerung': true,
      newsletter: true,
      contact: true,
      footer: true,
    },
    variants: {
      about: 'duo',
      servicesCols: '3',
      servicesRows: '2',
      galleryMode: 'carousel',
      galleryCols: '3',
      galleryRows: '2'
    }
  };

  let state = JSON.parse(JSON.stringify(defaultState));
  try {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      const parsed = JSON.parse(saved);
      state.sections = { ...defaultState.sections, ...(parsed.sections || {}) };
      state.variants = { ...defaultState.variants, ...(parsed.variants || {}) };
      if (parsed.colors && parsed.colors.accent) {
        state.colors = { ...defaultColors, ...parsed.colors };
      }
      if (parsed.countdown && parsed.countdown.target) {
        state.countdown = {
          target: parsed.countdown.target || 'hero',
          position: parsed.countdown.position || 'before'
        };
      }
      if (Array.isArray(parsed.order) && parsed.order.length > 0) {
        const loadedOrder = parsed.order.filter(id => id !== 'countdown' && defaultOrder.includes(id));
        defaultOrder.forEach(id => {
          if (!loadedOrder.includes(id)) loadedOrder.push(id);
        });
        state.order = loadedOrder;
      }
    }
  } catch (e) {}

  function saveState() {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch (e) {}
  }

  function setOpen(open) {
    drawer.hidden = !open;
    fab.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('hpse-drawer-open', open);
    if (open) {
      requestAnimationFrame(() => drawer.classList.add('is-open'));
    } else {
      drawer.classList.remove('is-open');
      setTimeout(() => { if (!drawer.classList.contains('is-open')) drawer.hidden = true; }, 320);
    }
  }

  // Verhindert Scroll-Chaining & Durchscrollen auf die Homepage beim Scrollen im Drawer
  drawer.addEventListener('wheel', (e) => {
    e.stopPropagation();
  }, true);
  drawer.addEventListener('touchmove', (e) => {
    e.stopPropagation();
  }, { passive: true });

  fab.addEventListener('click', () => setOpen(!drawer.classList.contains('is-open')));
  closeBtn?.addEventListener('click', () => setOpen(false));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer.classList.contains('is-open')) setOpen(false);
    if (e.altKey && (e.key === 'e' || e.key === 'E')) {
      e.preventDefault();
      setOpen(!drawer.classList.contains('is-open'));
    }
  });

  function scrollToSection(secId) {
    if (!secId) return;
    let targetEl = null;
    if (secId === 'hero' || secId === 'countdown') {
      targetEl = document.querySelector('.hero-snap') || document.getElementById(secId);
    } else if (secId === 'contact' || secId === 'footer') {
      targetEl = document.getElementById(secId) || document.querySelector('.contact-footer-snap');
    } else {
      targetEl = document.getElementById(secId);
    }
    if (!targetEl) return;

    if (typeof window.__HPSE_SCROLL_TO__ === 'function') {
      window.__HPSE_SCROLL_TO__(targetEl);
    } else {
      const navEl = document.querySelector('.nav') || document.getElementById('nav');
      const navH = navEl ? navEl.offsetHeight : 72;
      const targetY = Math.max(0, targetEl.offsetTop - navH);
      window.scrollTo({ top: targetY, behavior: 'smooth' });
    }
  }

  // Accordion Toggle
  accordion?.querySelectorAll('.hpse-acc-trigger').forEach(trigger => {
    trigger.addEventListener('click', () => {
      const item = trigger.closest('.hpse-acc-item');
      const content = item?.querySelector('.hpse-acc-content');
      const isExpanded = item.classList.contains('is-expanded');
      const willExpand = !isExpanded;
      
      item.classList.toggle('is-expanded', willExpand);
      trigger.setAttribute('aria-expanded', String(willExpand));
      if (content) content.hidden = !willExpand;

      // Beim Aufklappen: Seite automatisch zum Zielbereich scrollen
      if (willExpand) {
        const secId = item.getAttribute('data-acc-id');
        scrollToSection(secId);
      }
    });
  });

  function applyTypography() {
    const typo = state.typography || defaultTypography;
    const pair = fontPairs[typo.fontPair] || fontPairs['dm-outfit'];
    const scale = fontScales[typo.scale] || fontScales['normal'];

    document.documentElement.style.setProperty('--serif', pair.serif);
    document.documentElement.style.setProperty('--sans', pair.sans);

    document.documentElement.style.setProperty('--fs-xl', scale.xl);
    document.documentElement.style.setProperty('--fs-lg', scale.lg);
    document.documentElement.style.setProperty('--fs-md', scale.md);
    document.documentElement.style.setProperty('--fs-base', scale.base);
    document.documentElement.style.setProperty('--fs-sm', scale.sm);

    const selPair = document.getElementById('hpse-font-pair');
    if (selPair && typo.fontPair) selPair.value = typo.fontPair;
    const selScale = document.getElementById('hpse-font-scale');
    if (selScale && typo.scale) selScale.value = typo.scale;
  }

  function applyColors() {
    const cols = state.colors || defaultColors;
    const acc = cols.accent || '#c8520e';
    const ink = cols.ink || '#1c1c1c';
    const cream = cols.cream || '#f5f0e8';
    const sage = cols.sage || '#4a7c6f';
    const accL = cols.accentLight || '#e2a63b';
    const muted = cols.inkMuted || '#5c5c5c';

    document.documentElement.style.setProperty('--accent', acc);
    document.documentElement.style.setProperty('--accent-text', `color-mix(in srgb, ${acc} 75%, #000)`);
    document.documentElement.style.setProperty('--accent-light', accL);
    document.documentElement.style.setProperty('--ink', ink);
    document.documentElement.style.setProperty('--bg', ink);
    document.documentElement.style.setProperty('--nav-bg', ink);
    document.documentElement.style.setProperty('--footer-bg', ink);
    document.documentElement.style.setProperty('--cream', cream);
    document.documentElement.style.setProperty('--sage', sage);
    document.documentElement.style.setProperty('--ink-muted', muted);

    const pairs = [
      { key: 'accent', val: acc },
      { key: 'ink', val: ink },
      { key: 'cream', val: cream },
      { key: 'sage', val: sage },
      { key: 'accentLight', val: accL },
      { key: 'inkMuted', val: muted }
    ];
    pairs.forEach(({ key, val }) => {
      const inp = document.getElementById('hpse-col-' + key);
      if (inp) inp.value = val;
      const dot = document.getElementById('hpse-dot-' + key);
      if (dot) dot.style.background = val;
      const lbl = document.getElementById('hpse-val-' + key);
      if (lbl) lbl.textContent = val;
    });
  }

  function applyCountdown() {
    const cd = document.getElementById('countdown');
    if (!cd) return;

    const enabled = state.sections.countdown !== false;
    cd.setAttribute('data-hpse-hidden', String(!enabled));

    const cdBox = document.getElementById('hpse-addon-box');
    if (cdBox) {
      cdBox.style.opacity = enabled ? '1' : '0.6';
    }

    if (!enabled) {
      document.documentElement.style.setProperty('--cd-h', '0px');
      return;
    }

    const targetId = state.countdown?.target || 'hero';
    const pos = state.countdown?.position || 'before';

    const heroSnap = document.querySelector('.hero-snap');

    if (targetId === 'hero') {
      if (heroSnap) {
        if (pos === 'before') {
          const heroEl = document.getElementById('hero');
          if (heroEl) heroSnap.insertBefore(cd, heroEl);
          else heroSnap.prepend(cd);
        } else {
          heroSnap.appendChild(cd);
        }
        document.documentElement.style.setProperty('--cd-h', (cd.offsetHeight || 96) + 'px');
      }
    } else {
      document.documentElement.style.setProperty('--cd-h', '0px');
      const targetEl = document.getElementById(targetId);
      if (targetEl && targetEl.parentElement) {
        if (pos === 'before') {
          targetEl.parentElement.insertBefore(cd, targetEl);
        } else {
          targetEl.parentElement.insertBefore(cd, targetEl.nextSibling);
        }
      }
    }

    const selTarget = document.getElementById('hpse-cd-target');
    if (selTarget && state.countdown?.target) selTarget.value = state.countdown.target;
    const selPos = document.getElementById('hpse-cd-pos');
    if (selPos && state.countdown?.position) selPos.value = state.countdown.position;
  }

  const sectionMeta = {
    hero: { title: 'Hero (Startbereich)', icon: '🏠' },
    about: { title: 'Über uns', icon: '👥' },
    services: { title: 'Leistungen', icon: '🛠️' },
    gallery: { title: 'Galerie / Sortiment', icon: '🖼️' },
    pricing: { title: 'Preise', icon: '🏷️' },
    reviews: { title: 'Bewertungen', icon: '⭐' },
    booking: { title: 'Buchung / Termin', icon: '📅' },
    sponsors: { title: 'Sponsoren / Partner', icon: '🤝' },
    'hamburg-tour': { title: 'Hamburg Touren', icon: '⚓' },
    'service-erinnerung': { title: 'Erinnerungs-Service', icon: '⏰' },
    newsletter: { title: 'Newsletter', icon: '📧' },
    contact: { title: 'Kontakt', icon: '✉️' },
    footer: { title: 'Footer', icon: '📄' }
  };

  let draggedSortId = null;
  let placeholderEl = null;

  function removePlaceholder() {
    if (placeholderEl && placeholderEl.parentElement) {
      placeholderEl.remove();
    }
    placeholderEl = null;
  }

  function renderSortList() {
    const listEl = document.getElementById('hpse-sort-list');
    if (!listEl) return;

    let rawOrder = (state.order || defaultOrder).filter(id => id !== 'countdown' && sectionMeta[id]);
    const middle = rawOrder.filter(id => id !== 'hero' && id !== 'footer');
    const curOrder = ['hero', ...middle, 'footer'];

    listEl.innerHTML = curOrder.map((id, idx) => {
      const meta = sectionMeta[id] || { title: id, icon: '📌' };
      const numStr = String(idx + 1).padStart(2, '0');
      const isHero = id === 'hero';
      const isFooter = id === 'footer';
      const isPinned = isHero || isFooter;
      const isFirst = idx <= 1;
      const isLast = idx >= curOrder.length - 2;
      const isEnabled = state.sections[id] !== false;

      return `
        <div class="hpse-sort-card ${isPinned ? 'hpse-sort-card--pinned' : ''}" data-sort-id="${id}" draggable="${!isPinned}">
          <div class="hpse-sort-card-left">
            ${isPinned 
              ? '<span class="hpse-sort-pin-badge" style="font-size: 0.68rem; font-weight: 700; background: rgba(255,255,255,0.08); padding: 2px 6px; border-radius: 4px; color: #9ca3af;">Fest</span>' 
              : '<span class="hpse-sort-handle" title="Ziehen zum Verschieben">⠿</span>'}
            <span class="hpse-sort-num">${numStr}</span>
            <span class="hpse-sort-icon">${meta.icon}</span>
            <span class="hpse-sort-name">${meta.title} ${isHero ? '(Kopfzeile / Start)' : isFooter ? '(Fußzeile / Ende)' : ''}</span>
            ${!isEnabled ? '<span class="hpse-sort-badge-off">Aus</span>' : ''}
          </div>
          <div class="hpse-sort-card-right">
            ${isPinned ? '<span style="font-size: 0.72rem; color: #6b7280; font-weight: 600;">' + (isHero ? 'Seite 1' : 'Letzte Seite') + '</span>' : `
              <button type="button" class="hpse-sort-btn hpse-sort-up" data-move-id="${id}" data-dir="up" ${isFirst ? 'disabled' : ''} title="Nach oben">▲</button>
              <button type="button" class="hpse-sort-btn hpse-sort-down" data-move-id="${id}" data-dir="down" ${isLast ? 'disabled' : ''} title="Nach unten">▼</button>
            `}
          </div>
        </div>
      `;
    }).join('');

    initSortListEvents();
  }

  function initSortListEvents() {
    const listEl = document.getElementById('hpse-sort-list');
    if (!listEl) return;

    // Pfeiltasten ▲ ▼
    listEl.querySelectorAll('.hpse-sort-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const id = btn.getAttribute('data-move-id');
        const dir = btn.getAttribute('data-dir');
        const curOrder = (state.order || defaultOrder).filter(x => x !== 'countdown');
        const idx = curOrder.indexOf(id);
        if (idx === -1) return;
        if (dir === 'up' && idx > 0) {
          curOrder.splice(idx, 1);
          curOrder.splice(idx - 1, 0, id);
        } else if (dir === 'down' && idx < curOrder.length - 1) {
          curOrder.splice(idx, 1);
          curOrder.splice(idx + 1, 0, id);
        }
        state.order = curOrder;
        saveState();
        applyOrder();
      });
    });

    // Drag & Drop mit visuellem Platzhalter
    listEl.querySelectorAll('.hpse-sort-card').forEach(card => {
      card.addEventListener('dragstart', (e) => {
        draggedSortId = card.getAttribute('data-sort-id');
        card.classList.add('is-dragging');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', draggedSortId);
        }
      });

      card.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedSortId) return;
        const targetId = card.getAttribute('data-sort-id');
        if (targetId === draggedSortId) return;

        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';

        const rect = card.getBoundingClientRect();
        const isBefore = e.clientY < rect.top + rect.height / 2;

        if (!placeholderEl) {
          placeholderEl = document.createElement('div');
          placeholderEl.className = 'hpse-drop-placeholder';
        }

        const draggedMeta = sectionMeta[draggedSortId] || { title: draggedSortId };
        placeholderEl.innerHTML = `<span>↓ "${draggedMeta.title}" hier einfügen ↓</span>`;

        if (isBefore) {
          if (card.previousElementSibling !== placeholderEl) {
            card.parentElement.insertBefore(placeholderEl, card);
          }
        } else {
          if (card.nextElementSibling !== placeholderEl) {
            card.parentElement.insertBefore(placeholderEl, card.nextSibling);
          }
        }
      });

      card.addEventListener('drop', (e) => {
        e.preventDefault();
        if (!draggedSortId) return;

        const newOrder = [];
        [...listEl.children].forEach(child => {
          if (child === placeholderEl) {
            newOrder.push(draggedSortId);
          } else if (child.classList.contains('hpse-sort-card')) {
            const id = child.getAttribute('data-sort-id');
            if (id !== draggedSortId) {
              newOrder.push(id);
            }
          }
        });

        removePlaceholder();
        draggedSortId = null;

        if (newOrder.length > 0) {
          state.order = newOrder;
          saveState();
          applyOrder();
        }
      });

      card.addEventListener('dragend', () => {
        card.classList.remove('is-dragging');
        removePlaceholder();
        draggedSortId = null;
      });
    });

    // Touch Drag & Drop mit visuellem Platzhalter
    let touchCard = null;
    listEl.querySelectorAll('.hpse-sort-handle').forEach(handle => {
      handle.addEventListener('touchstart', (e) => {
        const card = handle.closest('.hpse-sort-card');
        if (!card) return;
        touchCard = card;
        draggedSortId = card.getAttribute('data-sort-id');
        touchCard.classList.add('is-dragging');
      }, { passive: true });

      handle.addEventListener('touchmove', (e) => {
        if (!touchCard || !draggedSortId) return;
        const touch = e.touches[0];
        const targetEl = document.elementFromPoint(touch.clientX, touch.clientY);
        const hoverCard = targetEl ? targetEl.closest('.hpse-sort-card') : null;
        if (hoverCard && hoverCard !== touchCard && listEl.contains(hoverCard)) {
          const rect = hoverCard.getBoundingClientRect();
          const isBefore = touch.clientY < rect.top + rect.height / 2;
          if (!placeholderEl) {
            placeholderEl = document.createElement('div');
            placeholderEl.className = 'hpse-drop-placeholder';
          }
          const draggedMeta = sectionMeta[draggedSortId] || { title: draggedSortId };
          placeholderEl.innerHTML = `<span>↓ "${draggedMeta.title}" hier einfügen ↓</span>`;

          if (isBefore) {
            hoverCard.parentElement.insertBefore(placeholderEl, hoverCard);
          } else {
            hoverCard.parentElement.insertBefore(placeholderEl, hoverCard.nextSibling);
          }
        }
      }, { passive: true });

      handle.addEventListener('touchend', () => {
        if (!touchCard || !draggedSortId) return;
        if (placeholderEl && placeholderEl.parentElement) {
          const newOrder = [];
          [...listEl.children].forEach(child => {
            if (child === placeholderEl) {
              newOrder.push(draggedSortId);
            } else if (child.classList.contains('hpse-sort-card')) {
              const id = child.getAttribute('data-sort-id');
              if (id !== draggedSortId) {
                newOrder.push(id);
              }
            }
          });
          removePlaceholder();
          if (newOrder.length > 0) {
            state.order = newOrder;
            saveState();
            applyOrder();
          }
        }
        touchCard.classList.remove('is-dragging');
        removePlaceholder();
        touchCard = null;
        draggedSortId = null;
      });

      handle.addEventListener('touchcancel', () => {
        if (touchCard) touchCard.classList.remove('is-dragging');
        removePlaceholder();
        touchCard = null;
        draggedSortId = null;
      });
    });
  }

  // Accordion Drag & Drop in der Hauptliste
  let draggedAccId = null;
  let accPlaceholderEl = null;

  function removeAccPlaceholder() {
    if (accPlaceholderEl && accPlaceholderEl.parentElement) {
      accPlaceholderEl.remove();
    }
    accPlaceholderEl = null;
  }

  function initAccordionDragAndDrop() {
    if (!accordion) return;

    // Desktop Drag & Drop
    accordion.querySelectorAll('.hpse-acc-item').forEach(item => {
      item.addEventListener('dragstart', (e) => {
        if (e.target.closest('input, select, .hpse-acc-content')) {
          e.preventDefault();
          return;
        }
        draggedAccId = item.getAttribute('data-acc-id');
        item.classList.add('is-dragging');
        if (e.dataTransfer) {
          e.dataTransfer.effectAllowed = 'move';
          e.dataTransfer.setData('text/plain', draggedAccId);
        }
      });

      item.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (!draggedAccId) return;
        const targetId = item.getAttribute('data-acc-id');
        if (targetId === draggedAccId) return;

        if (e.dataTransfer) e.dataTransfer.dropEffect = 'move';

        const rect = item.getBoundingClientRect();
        const isBefore = e.clientY < rect.top + rect.height / 2;

        if (!accPlaceholderEl) {
          accPlaceholderEl = document.createElement('div');
          accPlaceholderEl.className = 'hpse-drop-placeholder';
        }

        const draggedMeta = sectionMeta[draggedAccId] || { title: draggedAccId };
        accPlaceholderEl.innerHTML = `<span>↓ "${draggedMeta.title}" hier einfügen ↓</span>`;

        if (isBefore) {
          if (item.previousElementSibling !== accPlaceholderEl) {
            item.parentElement.insertBefore(accPlaceholderEl, item);
          }
        } else {
          if (item.nextElementSibling !== accPlaceholderEl) {
            item.parentElement.insertBefore(accPlaceholderEl, item.nextSibling);
          }
        }
      });

      item.addEventListener('drop', (e) => {
        e.preventDefault();
        if (!draggedAccId) return;

        const newOrder = [];
        [...accordion.children].forEach(child => {
          if (child === accPlaceholderEl) {
            newOrder.push(draggedAccId);
          } else if (child.classList.contains('hpse-acc-item')) {
            const id = child.getAttribute('data-acc-id');
            if (id && id !== draggedAccId) {
              newOrder.push(id);
            }
          }
        });

        removeAccPlaceholder();
        draggedAccId = null;

        if (newOrder.length > 0) {
          state.order = newOrder;
          saveState();
          applyOrder();
        }
      });

      item.addEventListener('dragend', () => {
        item.classList.remove('is-dragging');
        removeAccPlaceholder();
        draggedAccId = null;
      });
    });

    // Touch Drag & Drop auf Handle
    let touchAccItem = null;
    accordion.querySelectorAll('.hpse-acc-drag-handle').forEach(handle => {
      handle.addEventListener('touchstart', (e) => {
        const item = handle.closest('.hpse-acc-item');
        if (!item) return;
        touchAccItem = item;
        draggedAccId = item.getAttribute('data-acc-id');
        touchAccItem.classList.add('is-dragging');
      }, { passive: true });

      handle.addEventListener('touchmove', (e) => {
        if (!touchAccItem || !draggedAccId) return;
        const touch = e.touches[0];
        const targetEl = document.elementFromPoint(touch.clientX, touch.clientY);
        const hoverItem = targetEl ? targetEl.closest('.hpse-acc-item') : null;
        if (hoverItem && hoverItem !== touchAccItem && accordion.contains(hoverItem)) {
          const rect = hoverItem.getBoundingClientRect();
          const isBefore = touch.clientY < rect.top + rect.height / 2;
          if (!accPlaceholderEl) {
            accPlaceholderEl = document.createElement('div');
            accPlaceholderEl.className = 'hpse-drop-placeholder';
          }
          const draggedMeta = sectionMeta[draggedAccId] || { title: draggedAccId };
          accPlaceholderEl.innerHTML = `<span>↓ "${draggedMeta.title}" hier einfügen ↓</span>`;

          if (isBefore) {
            hoverItem.parentElement.insertBefore(accPlaceholderEl, hoverItem);
          } else {
            hoverItem.parentElement.insertBefore(accPlaceholderEl, hoverItem.nextSibling);
          }
        }
      }, { passive: true });

      handle.addEventListener('touchend', () => {
        if (!touchAccItem || !draggedAccId) return;
        if (accPlaceholderEl && accPlaceholderEl.parentElement) {
          const newOrder = [];
          [...accordion.children].forEach(child => {
            if (child === accPlaceholderEl) {
              newOrder.push(draggedAccId);
            } else if (child.classList.contains('hpse-acc-item')) {
              const id = child.getAttribute('data-acc-id');
              if (id && id !== draggedAccId) {
                newOrder.push(id);
              }
            }
          });
          removeAccPlaceholder();
          if (newOrder.length > 0) {
            state.order = newOrder;
            saveState();
            applyOrder();
          }
        }
        touchAccItem.classList.remove('is-dragging');
        removeAccPlaceholder();
        touchAccItem = null;
        draggedAccId = null;
      });

      handle.addEventListener('touchcancel', () => {
        if (touchAccItem) touchAccItem.classList.remove('is-dragging');
        removeAccPlaceholder();
        touchAccItem = null;
        draggedAccId = null;
      });
    });
  }

  function applyOrder() {
    let rawOrder = (state.order || defaultOrder).filter(id => id !== 'countdown');
    const middleSections = rawOrder.filter(id => id !== 'hero' && id !== 'footer');
    const curOrder = ['hero', ...middleSections, 'footer'];
    state.order = [ ...curOrder ];

    // 1. Accordion-Elemente im Editor anordnen
    if (accordion) {
      curOrder.forEach(id => {
        const item = accordion.querySelector(`.hpse-acc-item[data-acc-id="${id}"]`);
        if (item) accordion.appendChild(item);
      });
    }

    // 2. Sort-Liste im Sortier-Menü aktualisieren
    renderSortList();

    // 3. Sektionen im Hauptbereich anordnen (#main bzw. .mobile-swipe-track)
    const mainContainer = document.querySelector('.mobile-swipe-track') || document.getElementById('main');
    if (mainContainer) {
      const heroSnap = document.querySelector('.hero-snap');
      const cfSnap = document.querySelector('.contact-footer-snap');

      // 1. Hero / Kopfzeile immer fest an erster Position
      if (heroSnap) {
        mainContainer.prepend(heroSnap);
      }

      // 2. Mittlere Inhaltsbereiche in gewünschter Reihenfolge
      middleSections.forEach(id => {
        const sec = document.getElementById(id);
        if (sec && sec.parentElement === mainContainer) {
          mainContainer.appendChild(sec);
        }
        if (id === 'reviews') {
          const vrev = document.getElementById('verified-reviews');
          if (vrev && vrev.parentElement === mainContainer) {
            mainContainer.appendChild(vrev);
          }
        }
      });

      // 3. Fußzeile / Footer immer fest an letzter Position
      if (cfSnap) {
        mainContainer.appendChild(cfSnap);
        const ct = document.getElementById('contact');
        const ft = document.querySelector('footer');
        if (ct && ft) {
          cfSnap.appendChild(ct);
          cfSnap.appendChild(ft);
        }
      }
    }

      // Countdown als modularer Anhang platzieren
      applyCountdown();

      // Erste sichtbare Sektion für Nav-Abstand ermitteln
      const topEl = [...mainContainer.children].find(el => el.getAttribute('data-hpse-hidden') !== 'true');
      const allSections = [...mainContainer.querySelectorAll(':scope > section')];
      allSections.forEach(s => s.classList.remove('hpse-first-visible'));
      if (topEl && topEl.tagName.toLowerCase() === 'section') {
        topEl.classList.add('hpse-first-visible');
      }
    }

    // 4. Desktop-Navigation Links anordnen (#navLinks / .nav-ul)
    const navUl = document.getElementById('navLinks') || document.querySelector('.nav-ul');
    if (navUl) {
      curOrder.forEach(id => {
        const link = navUl.querySelector(`a[href*="#${id}"]`);
        if (link) {
          const li = link.closest('li') || link;
          navUl.appendChild(li);
        }
      });
    }

    // 5. Mobile Navigation Tabs anordnen (#mobile-nav-tabs)
    const mobTabs = document.getElementById('mobile-nav-tabs');
    if (mobTabs) {
      curOrder.forEach(id => {
        const tab = mobTabs.querySelector(`.mnt[data-tab-id="${id}"]`);
        if (tab) {
          mobTabs.appendChild(tab);
        }
      });
      if (typeof window.__HPSE_MOBILE_REINDEX__ === 'function') {
        window.__HPSE_MOBILE_REINDEX__();
      }
    }
  }

  function applyState() {
    applyOrder();
    applyColors();
    applyTypography();
    // 1. Toggles anwenden
    Object.entries(state.sections).forEach(([id, enabled]) => {
      if (id === 'countdown') {
        const cd = document.getElementById('countdown');
        if (cd) {
          cd.setAttribute('data-hpse-hidden', String(!enabled));
          if (!enabled) document.documentElement.style.setProperty('--cd-h', '0px');
          else document.documentElement.style.setProperty('--cd-h', (cd.offsetHeight || 96) + 'px');
        }
      } else if (id === 'hero') {
        const h = document.getElementById('hero');
        if (h) h.setAttribute('data-hpse-hidden', String(!enabled));
      } else if (id === 'footer') {
        const ft = document.querySelector('footer');
        if (ft) ft.setAttribute('data-hpse-hidden', String(!enabled));
      } else {
        const el = document.getElementById(id);
        if (el) el.setAttribute('data-hpse-hidden', String(!enabled));
      }

      // Nav-Link für diesen Bereich dynamisch ein-/ausblenden
      const navLinks = document.querySelectorAll(`.nav-ul a[href*="#${id}"]`);
      navLinks.forEach(navLink => {
        navLink.setAttribute('data-hpse-nav-hidden', String(!enabled));
        const li = navLink.closest('li') || navLink.parentElement;
        if (li) {
          li.setAttribute('data-hpse-nav-hidden', String(!enabled));
          if (!enabled) {
            li.style.setProperty('display', 'none', 'important');
          } else {
            li.style.removeProperty('display');
          }
        }
      });

      // Mobile Nav Tab für diesen Bereich ein-/ausblenden
      const mobTabs = document.querySelectorAll(`#mobile-nav-tabs .mnt[data-tab-id="${id}"]`);
      mobTabs.forEach(tab => {
        if (!enabled) {
          tab.style.setProperty('display', 'none', 'important');
        } else {
          tab.style.removeProperty('display');
        }
      });

      const cb = accordion?.querySelector(`input[data-section="${id}"]`);
      if (cb) cb.checked = !!enabled;
    });

    // Snap container checks
    const heroSnap = document.querySelector('.hero-snap');
    if (heroSnap) {
      const heroOn = state.sections.hero !== false;
      const cdOn = state.sections.countdown !== false && !!document.getElementById('countdown');
      const isHeroHidden = !heroOn && !cdOn;
      heroSnap.setAttribute('data-hpse-hidden', String(isHeroHidden));
    }

    const cfSnap = document.querySelector('.contact-footer-snap');
    if (cfSnap) {
      const contactOn = state.sections.contact !== false;
      const footerOn = state.sections.footer !== false;
      // Wenn Kontakt abgewählt ist, darf der 100vh-Snap-Container nicht als leerer Kasten stehen bleiben
      cfSnap.setAttribute('data-hpse-hidden', String(!contactOn));
    }

    // Markierung der ersten sichtbaren Sektion für perfekten Abstand unter fixer Nav
    const allSections = [...document.querySelectorAll('#main > section')];
    allSections.forEach(s => s.classList.remove('hpse-first-visible'));
    const heroSnapHidden = heroSnap && heroSnap.getAttribute('data-hpse-hidden') === 'true';
    if (heroSnapHidden) {
      const firstVis = allSections.find(s => s.getAttribute('data-hpse-hidden') !== 'true');
      if (firstVis) firstVis.classList.add('hpse-first-visible');
    }

    // 2. Varianten anwenden
    document.body.classList.remove('hpse-about-solo', 'hpse-about-duo', 'hpse-about-team');
    document.body.classList.add(`hpse-about-${state.variants.about || 'duo'}`);
    if (aboutSelect) aboutSelect.value = state.variants.about || 'duo';

    // Leistungen Spalten & Zeilen
    const sCols = state.variants.servicesCols || '3';
    const sRows = state.variants.servicesRows || '2';
    document.body.classList.remove('hpse-srv-cols-2', 'hpse-srv-cols-3', 'hpse-srv-cols-4');
    document.body.classList.add(`hpse-srv-cols-${sCols}`);
    document.body.classList.remove('hpse-srv-rows-1', 'hpse-srv-rows-2', 'hpse-srv-rows-3');
    document.body.classList.add(`hpse-srv-rows-${sRows}`);
    if (srvColsSelect) srvColsSelect.value = sCols;
    if (srvRowsSelect) srvRowsSelect.value = sRows;

    // Galerie Darstellungsart, Spalten & Zeilen
    const gMode = state.variants.galleryMode || 'carousel';
    const gCols = state.variants.galleryCols || '3';
    const gRows = state.variants.galleryRows || '2';
    document.body.classList.toggle('hpse-gal-grid', gMode === 'grid');
    if (galModeSelect) galModeSelect.value = gMode;
    if (galGridOpts) galGridOpts.hidden = gMode !== 'grid';

    document.body.classList.remove('hpse-gal-cols-2', 'hpse-gal-cols-3', 'hpse-gal-cols-4');
    document.body.classList.add(`hpse-gal-cols-${gCols}`);
    document.body.classList.remove('hpse-gal-rows-1', 'hpse-gal-rows-2', 'hpse-gal-rows-3', 'hpse-gal-rows-all');
    document.body.classList.add(`hpse-gal-rows-${gRows}`);
    if (galColsSelect) galColsSelect.value = gCols;
    if (galRowsSelect) galRowsSelect.value = gRows;
  }

  aboutSelect?.addEventListener('change', (e) => {
    state.variants.about = e.target.value;
    saveState();
    applyState();
  });
  srvColsSelect?.addEventListener('change', (e) => {
    state.variants.servicesCols = e.target.value;
    saveState();
    applyState();
  });
  srvRowsSelect?.addEventListener('change', (e) => {
    state.variants.servicesRows = e.target.value;
    saveState();
    applyState();
  });
  galModeSelect?.addEventListener('change', (e) => {
    state.variants.galleryMode = e.target.value;
    saveState();
    applyState();
  });
  galColsSelect?.addEventListener('change', (e) => {
    state.variants.galleryCols = e.target.value;
    saveState();
    applyState();
  });
  galRowsSelect?.addEventListener('change', (e) => {
    state.variants.galleryRows = e.target.value;
    saveState();
    applyState();
  });

  const selPair = document.getElementById('hpse-font-pair');
  selPair?.addEventListener('change', (e) => {
    if (!state.typography) state.typography = { ...defaultTypography };
    state.typography.fontPair = e.target.value;
    applyTypography();
    saveState();
  });

  const selScale = document.getElementById('hpse-font-scale');
  selScale?.addEventListener('change', (e) => {
    if (!state.typography) state.typography = { ...defaultTypography };
    state.typography.scale = e.target.value;
    applyTypography();
    saveState();
  });

  ['accent', 'ink', 'cream', 'sage', 'accentLight', 'inkMuted'].forEach(colKey => {
    const el = document.getElementById('hpse-col-' + colKey);
    el?.addEventListener('input', (e) => {
      if (!state.colors) state.colors = { ...defaultColors };
      state.colors[colKey] = e.target.value;
      applyColors();
      applyTypography();
    });
    el?.addEventListener('change', () => {
      saveState();
    });
  });

  accordion?.addEventListener('change', (e) => {
    const target = e.target;
    if (target && target.matches('input[data-section]')) {
      const secKey = target.getAttribute('data-section');
      state.sections[secKey] = target.checked;
      saveState();
      applyState();
      // Beim Anschalten eines Bereiches sofort dorthin scrollen/fokussieren
      if (target.checked) {
        scrollToSection(secKey);
      }
    }
  });

  // Countdown Anhang Steuerung
  const cdAddonBox = document.getElementById('hpse-addon-box');
  const cdAddonHeader = document.getElementById('hpse-addon-header');
  const cdOptions = document.getElementById('hpse-cd-options');
  const cdToggleInp = document.getElementById('hpse-toggle-countdown');
  const cdTargetSelect = document.getElementById('hpse-cd-target');
  const cdPosSelect = document.getElementById('hpse-cd-pos');

  cdAddonHeader?.addEventListener('click', (e) => {
    if (e.target.closest('.hpse-toggle-label')) return;
    const isExpanded = cdAddonBox?.classList.contains('is-expanded');
    const willExpand = !isExpanded;
    cdAddonBox?.classList.toggle('is-expanded', willExpand);
    if (cdOptions) {
      cdOptions.hidden = !willExpand;
    }
  });

  cdToggleInp?.addEventListener('change', (e) => {
    state.sections.countdown = e.target.checked;
    saveState();
    applyState();
  });

  cdTargetSelect?.addEventListener('change', (e) => {
    if (!state.countdown) state.countdown = { target: 'hero', position: 'before' };
    state.countdown.target = e.target.value;
    saveState();
    applyCountdown();
  });

  cdPosSelect?.addEventListener('change', (e) => {
    if (!state.countdown) state.countdown = { target: 'hero', position: 'before' };
    state.countdown.position = e.target.value;
    saveState();
    applyCountdown();
  });

  // Sortier-Menü Steuerung
  const sortModal = document.getElementById('hpse-sort-modal');
  const openSortBtn = document.getElementById('hpse-open-sort-btn');
  const closeSortBtn = document.getElementById('hpse-close-sort-btn');
  const closeSortBtn2 = document.getElementById('hpse-close-sort-btn-2');
  const sortResetBtn = document.getElementById('hpse-sort-reset-btn');

  openSortBtn?.addEventListener('click', () => {
    if (sortModal) {
      sortModal.hidden = false;
      renderSortList();
    }
  });

  const hideSortModal = () => {
    if (sortModal) sortModal.hidden = true;
  };

  closeSortBtn?.addEventListener('click', hideSortModal);
  closeSortBtn2?.addEventListener('click', hideSortModal);

  sortResetBtn?.addEventListener('click', () => {
    state.order = [ ...defaultOrder ];
    saveState();
    applyOrder();
    renderSortList();
  });

  sectionsResetBtn?.addEventListener('click', () => {
    Object.keys(state.sections).forEach(k => state.sections[k] = true);
    state.order = [ ...defaultOrder ];
    saveState();
    applyState();
    renderSortList();
  });

  resetBtn?.addEventListener('click', () => {
    state = JSON.parse(JSON.stringify(defaultState));
    saveState();
    applyState();
    renderSortList();
    if (feedback) {
      feedback.textContent = 'Auf Standardwerte zurückgesetzt!';
      setTimeout(() => feedback.textContent = '', 2500);
    }
  });

  exportBtn?.addEventListener('click', () => {
    const jsonStr = JSON.stringify(state, null, 2);
    if (navigator.clipboard) {
      navigator.clipboard.writeText(jsonStr).then(() => {
        if (feedback) {
          feedback.textContent = 'Konfiguration kopiert!';
          setTimeout(() => feedback.textContent = '', 3000);
        }
      });
    } else {
      prompt('Konfiguration kopieren:', jsonStr);
    }
  });


  // ── Kontrast & Audit Engine (Kategorisiert & Eingeklappt) ──────────────────
  function getLuminance(r, g, b) {
    var a = [r, g, b].map(function (v) {
      v /= 255;
      return v <= 0.03928 ? v / 12.92 : Math.pow((v + 0.055) / 1.055, 2.4);
    });
    return a[0] * 0.2126 + a[1] * 0.7152 + a[2] * 0.0722;
  }

  function parseRGB(str) {
    if (!str || str === 'transparent' || str === 'inherit') return null;
    var m = str.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)(?:,\s*([\d.]+))?\)/);
    if (m) {
      var alpha = m[4] !== undefined ? parseFloat(m[4]) : 1;
      if (alpha < 0.1) return null;
      return { r: parseInt(m[1]), g: parseInt(m[2]), b: parseInt(m[3]), a: alpha };
    }
    var m2 = str.match(/color\(srgb\s+([\d.]+)\s+([\d.]+)\s+([\d.]+)(?:\s*\/\s*([\d.]+))?\)/);
    if (m2) {
      var alpha2 = m2[4] !== undefined ? parseFloat(m2[4]) : 1;
      if (alpha2 < 0.1) return null;
      return {
        r: Math.round(parseFloat(m2[1]) * 255),
        g: Math.round(parseFloat(m2[2]) * 255),
        b: Math.round(parseFloat(m2[3]) * 255),
        a: alpha2
      };
    }
    return null;
  }

  function getEffectiveBg(el) {
    // 1. Spezifische Buttons, Badges und gefärbte Container
    if (el.closest('.skip-link')) {
      return { r: 185, g: 70, b: 10, a: 1 };
    }
    if (el.closest('.btn-fill, a.cta-link, .pbadge, .btn-email, .btn-submit, .bk-submit, .btn-primary')) {
      var rootAcc = window.getComputedStyle(document.documentElement).getPropertyValue('--accent').trim();
      var accRgb = parseRGB(rootAcc);
      if (accRgb) return accRgb;
      return { r: 200, g: 82, b: 14, a: 1 }; // #c8520e
    }

    // 2. DOM Parent Background Walk
    var cur = el;
    while (cur && cur !== document.documentElement) {
      var bgStr = window.getComputedStyle(cur).backgroundColor;
      var rgb = parseRGB(bgStr);
      if (rgb && rgb.a > 0.4) return rgb;
      cur = cur.parentElement;
    }

    // 3. Body / Theme Hintergrund
    var bodyBg = parseRGB(window.getComputedStyle(document.body).backgroundColor);
    if (bodyBg && bodyBg.a > 0.4) return bodyBg;

    return { r: 28, g: 28, b: 28, a: 1 }; // #1c1c1c Ink
  }

  function runAudit() {
    var cats = {
      contrast: [],
      a11y: [],
      interactive: [],
      layout: []
    };

    // 1. Kontrast-Prüfung
    var textElements = document.querySelectorAll('h1, h2, h3, h4, p, a, span, button, strong, em, label, li');
    textElements.forEach(function (el) {
      if (el.closest('#hpse-editor') || el.closest('[hidden]') || el.closest('[data-hpse-hidden="true"]')) return;
      var text = (el.textContent || '').trim();
      if (!text || text.length < 2) return;
      if (el.children.length > 2 && text.length > 80) return;

      var style = window.getComputedStyle(el);
      if (style.display === 'none' || style.visibility === 'hidden' || style.opacity === '0') return;

      var fg = parseRGB(style.color);
      var bg = getEffectiveBg(el);
      if (!fg || !bg) return;

      var l1 = getLuminance(fg.r, fg.g, fg.b);
      var l2 = getLuminance(bg.r, bg.g, bg.b);
      var ratio = (Math.max(l1, l2) + 0.05) / (Math.min(l1, l2) + 0.05);

      var fs = parseFloat(style.fontSize);
      var isLarge = fs >= 24 || (fs >= 18 && (style.fontWeight === '700' || style.fontWeight === 'bold'));
      var minRatio = isLarge ? 3.0 : 4.5;
      var displayRatio = Math.round(ratio * 100) / 100;

      if (displayRatio < minRatio) {
        var tag = el.tagName.toLowerCase();
        var snippet = text.length > 28 ? text.slice(0, 28) + '…' : text;
        var selector = el.id ? '#' + el.id : (el.className ? '.' + el.className.split(' ')[0] : tag);

        var existing = cats.contrast.find(function (i) { return i.selector === selector && i.text === snippet; });
        if (!existing) {
          cats.contrast.push({
            type: displayRatio < (minRatio - 1) ? 'err' : 'warn',
            tag: tag + selector,
            text: snippet,
            ratio: displayRatio.toFixed(2),
            needed: minRatio.toFixed(1),
            msg: 'Kontrast: ' + displayRatio.toFixed(2) + ':1 (Soll: min. ' + minRatio.toFixed(1) + ':1)'
          });
        }
      }
    });

    // 2. Medien & Barrierefreiheit (Alt-Texte)
    document.querySelectorAll('img').forEach(function (img) {
      if (img.closest('#hpse-editor') || img.closest('[hidden]')) return;
      if (!img.hasAttribute('alt')) {
        cats.a11y.push({
          type: 'warn',
          tag: 'img',
          text: img.getAttribute('src') || 'Bild',
          ratio: '-',
          msg: 'Fehlendes alt-Attribut (Screenreader-Barriere)'
        });
      }
    });

    // 3. Interaktive Elemente (Klickflächen & leere Links)
    document.querySelectorAll('a, button').forEach(function (btn) {
      if (btn.closest('#hpse-editor') || btn.closest('[hidden]')) return;
      var text = (btn.textContent || '').trim();
      var ariaLabel = btn.getAttribute('aria-label');
      if (!text && !ariaLabel && !btn.querySelector('img[alt]')) {
        cats.interactive.push({
          type: 'warn',
          tag: btn.tagName.toLowerCase(),
          text: btn.getAttribute('href') || 'Button',
          ratio: '-',
          msg: 'Schaltfläche ohne sichtbaren Text oder aria-label'
        });
      }
    });

    // 4. Layout & Überschriften-Hierarchie
    var h1s = document.querySelectorAll('h1');
    if (h1s.length > 1) {
      cats.layout.push({
        type: 'warn',
        tag: 'h1',
        text: h1s.length + ' H1-Tags',
        ratio: '-',
        msg: 'Mehrere <h1> auf einer Seite (eine einzige H1 pro Seite empfohlen)'
      });
    }

    renderAuditCategories(cats);
  }

  function renderAuditCategories(cats) {
    var totalIssues = cats.contrast.length + cats.a11y.length + cats.interactive.length + cats.layout.length;
    var badge = document.getElementById('hpse-audit-badge');
    var errCountEl = document.getElementById('hpse-audit-err-count');
    var warnCountEl = document.getElementById('hpse-audit-warn-count');
    var statusBadge = document.getElementById('hpse-audit-status-badge');

    if (badge) badge.textContent = String(totalIssues);
    if (errCountEl) errCountEl.textContent = String(cats.contrast.length);
    if (warnCountEl) warnCountEl.textContent = String(cats.a11y.length + cats.interactive.length + cats.layout.length);
    if (statusBadge) {
      if (totalIssues === 0) {
        statusBadge.textContent = 'Sauber';
      } else {
        statusBadge.textContent = totalIssues + ' Funde';
      }
    }

    function renderCategory(catKey, listId, countId) {
      var listEl = document.getElementById(listId);
      var countEl = document.getElementById(countId);
      var items = cats[catKey] || [];

      if (countEl) {
        countEl.textContent = String(items.length);
        countEl.classList.toggle('has-items', items.length > 0);
      }

      if (!listEl) return;
      if (items.length === 0) {
        listEl.innerHTML = '<div class="hpse-audit-empty">Keine Probleme in dieser Kategorie.</div>';
        return;
      }

      listEl.innerHTML = items.slice(0, 8).map(function (i) {
        return '<div class="hpse-audit-item">' +
          '<div class="hpse-audit-item-head">' +
            '<span class="hpse-audit-item-badge">' + (i.type === 'err' ? 'Fehler' : 'Warnung') + '</span>' +
            '<span class="hpse-audit-item-target">' + i.tag + '</span>' +
          '</div>' +
          '<p class="hpse-audit-item-detail">' + i.msg + '</p>' +
          '<div style="display: flex; justify-content: space-between; align-items: center; margin-top: 2px; font-size: 0.7rem; color: #9ca3af;">' +
            '<span>"' + i.text + '"</span>' +
            (i.ratio !== '-' ? '<span class="hpse-audit-item-ratio">' + i.ratio + ':1</span>' : '') +
          '</div>' +
        '</div>';
      }).join('');
    }

    renderCategory('contrast', 'hpse-list-contrast', 'hpse-count-contrast');
    renderCategory('a11y', 'hpse-list-a11y', 'hpse-count-a11y');
    renderCategory('interactive', 'hpse-list-interactive', 'hpse-count-interactive');
    renderCategory('layout', 'hpse-list-layout', 'hpse-count-layout');
  }

  var auditToggle = document.getElementById('hpse-audit-toggle');
  var auditDrawer = document.getElementById('hpse-audit-drawer');
  var auditClose = document.getElementById('hpse-audit-close');
  var auditRefresh = document.getElementById('hpse-audit-refresh');

  auditToggle?.addEventListener('click', function () {
    var isOpen = auditDrawer.classList.toggle('is-open');
    auditDrawer.hidden = !isOpen;
    auditToggle.setAttribute('aria-expanded', String(isOpen));
    if (isOpen) runAudit();
  });

  auditClose?.addEventListener('click', function () {
    auditDrawer.classList.remove('is-open');
    auditDrawer.hidden = true;
    auditToggle.setAttribute('aria-expanded', 'false');
  });

  auditRefresh?.addEventListener('click', function () {
    runAudit();
  });

  applyState();
  renderSortList();
  initAccordionDragAndDrop();
  setTimeout(runAudit, 800);
})();
</script>
