<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    if (carousel.dataset.carouselInited) return;
    carousel.dataset.carouselInited = '1';
    const track = carousel.querySelector('[data-carousel-track]');
    if (!track) return;
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    const itemSel = track.dataset.carouselItem || ':scope > *';

    const EDGE_TOL = 8;

    // Blockweises Paging: vermisst Kartenbreite + Lücke, leitet daraus die
    // sichtbare Kartenzahl ab (3 auf Laptop/Desktop, 1-2 auf kleinen Screens)
    // und bildet Seitenstarts auf echte Kartenanfänge ab.
    const getPages = () => {
      const items = Array.from(track.querySelectorAll(itemSel));
      if (!items.length) return [0];
      const first = items[0].offsetLeft;
      const cardW = items[0].offsetWidth || 1;
      const gap = items.length > 1
        ? Math.max(0, items[1].offsetLeft - first - cardW)
        : 0;
      const step = cardW + gap;
      const visibleWidth = track.clientWidth || 1;
      const perView = Math.max(1, Math.round(visibleWidth / step));
      const pages = [];
      for (let i = 0; i < items.length; i += perView) {
        pages.push(items[i].offsetLeft - first);
      }
      return pages;
    };

    const maxScroll = () => track.scrollWidth - track.clientWidth;

    // Sperrfenster nach programmatischer Fahrt: Snap-Korrektur aussetzen,
    // bis die Smooth-Animation sicher beendet ist.
    let navigatingUntil = 0;

    const navigate = (forward) => {
      const pages = getPages();
      const current = track.scrollLeft;
      const max = maxScroll();
      let target;
      if (forward) {
        // Nächster Block: erster Seitenstart rechts der aktuellen Position
        const nextPage = pages.find(p => p > current + EDGE_TOL);
        target = nextPage !== undefined ? Math.min(max, nextPage) : max;
      } else {
        // Vorheriger Block: letzter Seitenstart links der aktuellen Position
        const prevPages = pages.filter(p => p < current - EDGE_TOL);
        target = prevPages.length ? Math.max(0, prevPages[prevPages.length - 1]) : 0;
      }

      navigatingUntil = Date.now() + 600;
      track.scrollTo({ left: target, behavior: 'smooth' });
    };

    // Freies Swipen/Scrollen rastet auf den nächsten Block ein,
    // damit keine Karte halb angeschnitten mitten im Viewport stehen bleibt.
    const snapToPage = () => {
      if (Date.now() < navigatingUntil) return;
      const max = maxScroll();
      if (max <= 1) return;
      const pages = getPages();
      const current = track.scrollLeft;
      const candidates = pages.concat([max]);
      let nearest = candidates[0];
      let best = Math.abs(current - nearest);
      for (const p of candidates) {
        const d = Math.abs(current - p);
        if (d < best) { best = d; nearest = p; }
      }
      if (best > EDGE_TOL) {
        navigatingUntil = Date.now() + 600;
        track.scrollTo({ left: nearest, behavior: 'smooth' });
      }
    };

    let snapTimer = null;
    if ('onscrollend' in window) {
      track.addEventListener('scrollend', snapToPage);
    } else {
      track.addEventListener('scroll', () => {
        clearTimeout(snapTimer);
        snapTimer = setTimeout(snapToPage, 180);
      }, { passive: true });
    }

    const update = () => {
      const padLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      const max = track.scrollWidth - track.clientWidth;
      const overflows = max > 1;
      if (prev) prev.hidden = !overflows || track.scrollLeft <= padLeft + 2;
      if (next) next.hidden = !overflows || track.scrollLeft >= max - 2;
    };

    prev?.addEventListener('click', () => navigate(false));
    next?.addEventListener('click', () => navigate(true));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>
