---
<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    if (carousel.dataset.carouselInited) return;
    carousel.dataset.carouselInited = '1';
    const track = carousel.querySelector('[data-carousel-track]');
    if (!track) return;
    const prev = carousel.querySelector('[data-carousel-prev]');
    const next = carousel.querySelector('[data-carousel-next]');
    const itemSel = track.dataset.carouselItem || ':scope > *';

    const EDGE_TOL = 8;
    // Eine feste Fahrtdauer in beide Richtungen: gleichmäßige Animation,
    // keine richtungs- oder distanzabhängigen Sprünge.
    const DURATION = 480;
    const SETTLE_DURATION = 260;
    const SNAP_IDLE_MS = 180;
    const reduceMotion =
      window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Blockweises Paging: vermisst Kartenbreite + Lücke, leitet daraus die
    // sichtbare Kartenzahl ab (3 auf Laptop/Desktop, 1-2 auf kleinen Screens)
    // und bildet Seitenstarts auf echte Kartenanfänge ab.
    const getPages = () => {
      const items = Array.from(track.querySelectorAll(itemSel));
      if (!items.length) return [0];
      const first = items[0].offsetLeft;
      const cardW = items[0].offsetWidth || 1;
      const gap = items.length > 1
        ? Math.max(0, items[1].offsetLeft - first - cardW)
        : 0;
      const step = cardW + gap;
      const visibleWidth = track.clientWidth || 1;
      const perView = Math.max(1, Math.round(visibleWidth / step));
      const pages = [];
      for (let i = 0; i < items.length; i += perView) {
        pages.push(Math.max(0, items[i].offsetLeft - first));
      }
      return pages;
    };

    const maxScroll = () => track.scrollWidth - track.clientWidth;

    const easeInOutCubic = (t) =>
      t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;

    let animId = 0;
    let animating = false;
    // Ziel der laufenden Fahrt: Mehrfachklicks ketten sich daran
    // (nächste Seite ab Ziel), statt die laufende Fahrt zu zerreißen.
    let queuedTarget = null;

    const restoreSnap = () => { track.style.scrollSnapType = ''; };

    const finishAnim = (target) => {
      if (animId) cancelAnimationFrame(animId);
      animId = 0;
      animating = false;
      queuedTarget = null;
      track.scrollLeft = target;
      restoreSnap();
      update();
    };

    const cancelAnim = () => {
      if (!animating) return;
      if (animId) cancelAnimationFrame(animId);
      animId = 0;
      animating = false;
      queuedTarget = null;
      restoreSnap();
      update();
    };

    // Nutzer-Geste bricht die Button-Fahrt ab: Touch/Swipe und
    // Mausrad behalten jederzeit die Kontrolle, kein Gegeneinander.
    track.addEventListener('pointerdown', cancelAnim, { passive: true });
    track.addEventListener('touchstart', cancelAnim, { passive: true });
    track.addEventListener('wheel', cancelAnim, { passive: true });

    const animateTo = (target, duration) => {
      const max = maxScroll();
      target = Math.max(0, Math.min(max, target));
      if (reduceMotion || duration <= 0) {
        animating = false;
        queuedTarget = null;
        track.scrollLeft = target;
        restoreSnap();
        update();
        return;
      }
      if (animId) cancelAnimationFrame(animId);
      const start = track.scrollLeft;
      const dist = target - start;
      if (Math.abs(dist) < 1) {
        animating = false;
        queuedTarget = null;
        track.scrollLeft = target;
        restoreSnap();
        update();
        return;
      }
      animating = true;
      queuedTarget = target;
      // Harter CSS-Snap würde die weiche Fahrt mid-animation einrasten
      // lassen (Ruckelursache) — während der Fahrt aussetzen, danach greift
      // wieder das weiche proximity-Einrasten aus dem CSS.
      track.style.scrollSnapType = 'none';
      const t0 = performance.now();
      const step = (now) => {
        const t = Math.min(1, (now - t0) / duration);
        track.scrollLeft = start + dist * easeInOutCubic(t);
        if (t < 1) {
          animId = requestAnimationFrame(step);
        } else {
          finishAnim(target);
        }
      };
      animId = requestAnimationFrame(step);
    };

    const navigate = (forward) => {
      const pages = getPages();
      const max = maxScroll();
      if (max <= 1) return;
      const base = animating && queuedTarget !== null ? queuedTarget : track.scrollLeft;
      let target;
      if (forward) {
        // Nächster Block: erster Seitenstart rechts der aktuellen Position
        const nextPage = pages.find(p => p > base + EDGE_TOL);
        target = nextPage !== undefined ? Math.min(max, nextPage) : max;
      } else {
        // Vorheriger Block: letzter Seitenstart links der aktuellen Position
        const prevPages = pages.filter(p => p < base - EDGE_TOL);
        target = prevPages.length ? Math.max(0, prevPages[prevPages.length - 1]) : 0;
      }
      animateTo(target, DURATION);
    };

    // Freies Swipen/Scrollen rastet weich auf den nächsten Block ein,
    // damit keine Karte halb angeschnitten mitten im Viewport stehen bleibt.
    // Läuft nur im Leerlauf (nicht während einer Button-Fahrt), damit es
    // keine zweite konkurrierende Fahrt gibt.
    const snapToPage = () => {
      if (animating || reduceMotion) return;
      const max = maxScroll();
      if (max <= 1) return;
      const pages = getPages();
      const current = track.scrollLeft;
      const candidates = pages.concat([max]);
      let nearest = candidates[0];
      let best = Math.abs(current - nearest);
      for (const p of candidates) {
        const d = Math.abs(current - p);
        if (d < best) { best = d; nearest = p; }
      }
      if (best > EDGE_TOL) {
        animateTo(nearest, SETTLE_DURATION);
      }
    };

    let snapTimer = null;
    if ('onscrollend' in window) {
      track.addEventListener('scrollend', () => { update(); snapToPage(); });
    }
    track.addEventListener('scroll', () => {
      update();
      if (animating) return;
      clearTimeout(snapTimer);
      snapTimer = setTimeout(snapToPage, SNAP_IDLE_MS);
    }, { passive: true });

    const update = () => {
      const padLeft = parseFloat(getComputedStyle(track).paddingLeft) || 0;
      const max = track.scrollWidth - track.clientWidth;
      const overflows = max > 1;
      if (prev) prev.hidden = !overflows || track.scrollLeft <= padLeft + 2;
      if (next) next.hidden = !overflows || track.scrollLeft >= max - 2;
    };

    prev?.addEventListener('click', () => navigate(false));
    next?.addEventListener('click', () => navigate(true));

    // Tastatur: Track fokussierbar machen, Pfeile/Home/Ende fahren Blöcke.
    // Buttons bleiben nativ tastaturbedienbar; Touch läuft unverändert nativ.
    if (!track.hasAttribute('tabindex')) track.setAttribute('tabindex', '0');
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); navigate(true); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); navigate(false); }
      else if (e.key === 'Home') { e.preventDefault(); animateTo(0, DURATION); }
      else if (e.key === 'End') { e.preventDefault(); animateTo(maxScroll(), DURATION); }
    });

    window.addEventListener('resize', () => { cancelAnim(); update(); });
    // Größenwechsel (Gate-Unlock, Fonts, Bildlast) aktualisieren die
    // Pfeilsichtbarkeit — auch wenn nie gescrollt/resized wurde.
    if ('ResizeObserver' in window) new ResizeObserver(update).observe(track);
    update();
  });
</script>
