---
import SectionHeader from './SectionHeader.astro';
import '../styles/hamburg-tour.css';
---

<section class="section" id="hamburg-tour" aria-label="Hamburg Liefertouren und Zonen">
  <div class="wrap">
    <SectionHeader
      headline="Hamburg Touren"
      subline="Vier Zonen, feste Liefertage: Wähle eine Zone auf der Karte, prüfe deine PLZ oder deinen Standort."
      center
    />
    <div class="ht-grid">
      <div class="ht-map">
        <div class="ht-map-frame">
          <div class="ht-map-container">
            <img
              src="/images/hamburg-lieferzonen.jpg"
              alt="Hamburg Lieferzonen: Zone 1 Nord, Zone 2 West, Zone 3 Mitte & Ost, Zone 4 Süd"
              class="ht-map-img"
              width="1672"
              height="941"
              loading="lazy"
            />
            <svg class="ht-map-overlay" viewBox="0 0 1672 941" preserveAspectRatio="xMidYMid meet" role="group" aria-label="Interaktive Hamburger Lieferzonen">
              <polygon
                class="ht-zone"
                data-zone="nord"
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label="Zone 1 Nord auswählen"
                points="1279,286 1105,310 1085,329 1050,334 1021,332 1012,341 1001,346 988,348 997,467 966,476 930,484 883,512 859,471 909,353 802,423 741,415 739,368 684,335 545,286 583,218 626,162 697,131 735,92 834,128 866,113 908,127 940,143 966,81 1010,30 1049,56 1112,33 1190,18 1171,113 1174,165 1319,157 1315,224"
              />
              <polygon
                class="ht-zone"
                data-zone="west"
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label="Zone 2 West auswählen"
                points="698,434 703,468 686,498 646,514 632,538 649,602 609,608 572,612 536,597 508,585 482,579 458,570 432,564 401,561 355,561 314,545 239,531 288,472 267,434 362,408 256,342 390,366 394,338 418,327 406,259 436,238 470,220 508,280 532,294 597,187 591,290 635,281 671,296 680,334 709,360 733,394"
              />
              <polygon
                class="ht-zone"
                data-zone="mitte-ost"
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label="Zone 3 Mitte und Ost auswählen"
                points="1369,499 1361,545 1431,620 1410,679 1367,725 1285,722 1208,689 1162,677 1130,683 1098,671 1071,647 1046,640 1006,658 954,669 782,763 834,651 761,621 621,583 692,499 709,430 837,404 876,371 901,334 952,325 1011,350 1038,334 1070,341 1098,321 1130,311 1184,261 1227,274 1272,291 1294,334 1418,313 1462,366 1388,447"
              />
              <polygon
                class="ht-zone"
                data-zone="sued"
                tabindex="0"
                role="button"
                aria-pressed="false"
                aria-label="Zone 4 Süd auswählen"
                points="1191,766 1083,823 1040,868 1031,924 924,905 887,920 823,878 800,882 778,882 758,884 736,888 721,865 703,860 687,849 667,841 570,874 582,829 423,825 277,766 387,700 410,639 619,686 605,638 641,627 674,622 707,626 740,667 758,651 776,658 794,666 811,674 824,687 855,684 888,690 936,701 1086,708"
              />
            </svg>
          </div>
        </div>
      </div>
      <div class="ht-panel">
        <div class="ht-info" aria-live="polite" aria-atomic="true">
          <span class="ht-info-kicker">Ausgewählte Zone</span>
          <h3 data-ht="name">Zone Mitte &amp; Ost</h3>
          <p class="ht-info-days" data-ht="days">Liefertouren: Mo &amp; Do</p>
          <ul class="ht-chips" data-ht="districts"></ul>
          <ul class="ht-next" data-ht="next"></ul>
        </div>
        <div class="ht-tools">
          <form class="ht-field" id="ht-plz-form" novalidate>
            <label for="ht-plz">PLZ-Schnellprüfung</label>
            <div class="ht-row">
              <input
                class="ht-input"
                id="ht-plz"
                name="plz"
                type="text"
                inputmode="numeric"
                autocomplete="postal-code"
                placeholder="z. B. 20354"
                maxlength="5"
                pattern="[0-9]{5}"
                aria-describedby="ht-plz-msg"
              />
              <button class="ht-btn ht-btn--primary" type="submit">Zone prüfen</button>
            </div>
            <p class="ht-msg" id="ht-plz-msg" aria-live="polite"></p>
          </form>
          <div class="ht-field">
            <button class="ht-btn ht-btn--geo" id="ht-geo" type="button">📍 Meinen Standort automatisch prüfen</button>
            <p class="ht-msg" id="ht-geo-msg" aria-live="polite"></p>
          </div>
          <ul class="ht-legend" aria-label="Zonenübersicht">
            <li><button type="button" data-zone-link="nord"><span class="ht-dot" data-zone="nord"></span>Zone Nord · Di &amp; Do</button></li>
            <li><button type="button" data-zone-link="west"><span class="ht-dot" data-zone="west"></span>Zone West · Mi &amp; Fr</button></li>
            <li><button type="button" data-zone-link="mitte-ost"><span class="ht-dot" data-zone="mitte-ost"></span>Mitte &amp; Ost · Mo &amp; Do</button></li>
            <li><button type="button" data-zone-link="sued"><span class="ht-dot" data-zone="sued"></span>Zone Süd · Di &amp; Sa</button></li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script is:inline>
(function () {
  var root = document.getElementById('hamburg-tour');
  if (!root) return;

  var ZONES = {
    'nord': {
      name: 'Zone Nord',
      districts: ['Eppendorf', 'Winterhude', 'Barmbek', 'Alsterdorf'],
      days: [{ label: 'Dienstag', short: 'Di', num: 2 }, { label: 'Donnerstag', short: 'Do', num: 4 }],
      center: [53.592, 9.982]
    },
    'west': {
      name: 'Zone West',
      districts: ['Altona', 'Ottensen', 'Eimsbüttel', 'St. Pauli', 'Elbvororte'],
      days: [{ label: 'Mittwoch', short: 'Mi', num: 3 }, { label: 'Freitag', short: 'Fr', num: 5 }],
      center: [53.555, 9.934]
    },
    'mitte-ost': {
      name: 'Zone Mitte & Ost',
      districts: ['City', 'HafenCity', 'Uhlenhorst', 'Wandsbek'],
      days: [{ label: 'Montag', short: 'Mo', num: 1 }, { label: 'Donnerstag', short: 'Do', num: 4 }],
      center: [53.543, 10.002]
    },
    'sued': {
      name: 'Zone Süd',
      districts: ['Wilhelmsburg', 'Harburg', 'Veddel', 'Finkenwerder'],
      days: [{ label: 'Dienstag', short: 'Di', num: 2 }, { label: 'Samstag', short: 'Sa', num: 6 }],
      center: [53.459, 9.982]
    }
  };

  var FALLBACK = 'mitte-ost';
  var fmt = new Intl.DateTimeFormat('de-DE', { weekday: 'long', day: '2-digit', month: '2-digit' });

  function nextDateFor(weekdayNum) {
    var now = new Date();
    var diff = (weekdayNum - now.getDay() + 7) % 7;
    var d = new Date(now.getFullYear(), now.getMonth(), now.getDate() + diff);
    return { date: d, isToday: diff === 0 };
  }

  function el(sel) { return root.querySelector(sel); }

  function render(zoneId) {
    var z = ZONES[zoneId];
    if (!z) return;
    el('[data-ht="name"]').textContent = z.name;
    el('[data-ht="days"]').textContent = 'Liefertouren: ' + z.days.map(function (d) { return d.short; }).join(' & ');
    var chips = el('[data-ht="districts"]');
    chips.innerHTML = '';
    z.districts.forEach(function (name) {
      var li = document.createElement('li');
      li.textContent = name;
      chips.appendChild(li);
    });
    var next = el('[data-ht="next"]');
    next.innerHTML = '';
    var seen = {};
    z.days.forEach(function (d) {
      var r = nextDateFor(d.num);
      var key = r.date.getTime();
      if (seen[key]) return;
      seen[key] = true;
      var li = document.createElement('li');
      var strong = document.createElement('strong');
      strong.textContent = r.isToday ? 'Heute' : d.label;
      li.appendChild(strong);
      li.appendChild(document.createTextNode(' · ' + fmt.format(r.date)));
      next.appendChild(li);
    });
  }

  function selectZone(zoneId) {
    if (!ZONES[zoneId]) return;
    root.querySelectorAll('.ht-zone').forEach(function (g) {
      var active = g.getAttribute('data-zone') === zoneId;
      g.classList.toggle('is-active', active);
      g.setAttribute('aria-pressed', active ? 'true' : 'false');
    });
    root.querySelectorAll('[data-zone-link]').forEach(function (btn) {
      var active = btn.getAttribute('data-zone-link') === zoneId;
      btn.classList.toggle('is-active', active);
    });
    render(zoneId);
  }

  root.querySelectorAll('.ht-zone').forEach(function (g) {
    g.addEventListener('click', function () { selectZone(g.getAttribute('data-zone')); });
    g.addEventListener('keydown', function (ev) {
      if (ev.key === 'Enter' || ev.key === ' ') {
        ev.preventDefault();
        selectZone(g.getAttribute('data-zone'));
      }
    });
  });

  root.querySelectorAll('[data-zone-link]').forEach(function (btn) {
    btn.addEventListener('click', function () { selectZone(btn.getAttribute('data-zone-link')); });
  });

  function plzToZone(plz) {
    if (!/^[0-9]{5}$/.test(plz)) return { error: 'Bitte eine 5-stellige PLZ eingeben (nur Ziffern).' };
    if (!/^(20[0-9]|21[0-2]|22[0-7])\d{2}$/.test(plz)) return { error: 'Die PLZ ' + plz + ' liegt außerhalb Hamburgs.' };
    if (plz === '20539') return { zone: 'sued' };
    var p3 = plz.slice(0, 3);
    var sued = ['208', '210', '211', '212'];
    var nord = ['222', '223', '224'];
    var west = ['201', '202', '203', '206', '225', '226', '227'];
    var mitteOst = ['200', '204', '205', '220', '221'];
    if (sued.indexOf(p3) !== -1) return { zone: 'sued' };
    if (nord.indexOf(p3) !== -1) return { zone: 'nord' };
    if (west.indexOf(p3) !== -1) return { zone: 'west' };
    if (mitteOst.indexOf(p3) !== -1) return { zone: 'mitte-ost' };
    return { zone: 'mitte-ost' };
  }

  var plzForm = el('#ht-plz-form');
  var plzInput = el('#ht-plz');
  var plzMsg = el('#ht-plz-msg');
  plzForm.addEventListener('submit', function (ev) {
    ev.preventDefault();
    var value = plzInput.value.trim();
    var res = plzToZone(value);
    plzMsg.classList.remove('ht-msg--ok', 'ht-msg--error');
    if (res.error) {
      plzMsg.textContent = res.error;
      plzMsg.classList.add('ht-msg--error');
      return;
    }
    selectZone(res.zone);
    plzMsg.textContent = 'PLZ ' + value + ' gehört zur ' + ZONES[res.zone].name + ' (' + ZONES[res.zone].days.map(function (d) { return d.short; }).join(' & ') + ').';
    plzMsg.classList.add('ht-msg--ok');
  });

  function haversineKm(aLat, aLon, bLat, bLon) {
    var R = 6371;
    var toRad = function (v) { return (v * Math.PI) / 180; };
    var dLat = toRad(bLat - aLat);
    var dLon = toRad(bLon - aLon);
    var s = Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos(toRad(aLat)) * Math.cos(toRad(bLat)) *
      Math.sin(dLon / 2) * Math.sin(dLon / 2);
    return 2 * R * Math.asin(Math.sqrt(s));
  }

  function nearestZone(lat, lon) {
    var best = FALLBACK;
    var bestDist = Infinity;
    Object.keys(ZONES).forEach(function (id) {
      var d = haversineKm(lat, lon, ZONES[id].center[0], ZONES[id].center[1]);
      if (d < bestDist) { bestDist = d; best = id; }
    });
    return { zone: best, distKm: bestDist };
  }

  var geoBtn = el('#ht-geo');
  var geoMsg = el('#ht-geo-msg');
  geoBtn.addEventListener('click', function () {
    geoMsg.classList.remove('ht-msg--ok', 'ht-msg--error');
    if (!('geolocation' in navigator)) {
      selectZone(FALLBACK);
      geoMsg.textContent = 'Dein Browser unterstützt keine Standortabfrage. Wir zeigen dir die Zone Mitte & Ost (Hamburg-Mitte) als Ausgangspunkt.';
      geoMsg.classList.add('ht-msg--error');
      return;
    }
    geoBtn.disabled = true;
    geoMsg.textContent = 'Standort wird ermittelt …';
    navigator.geolocation.getCurrentPosition(
      function (pos) {
        geoBtn.disabled = false;
        var res = nearestZone(pos.coords.latitude, pos.coords.longitude);
        if (res.distKm > 60) {
          selectZone(FALLBACK);
          geoMsg.textContent = 'Dein Standort liegt außerhalb Hamburgs. Wir zeigen dir die Zone Mitte & Ost (Hamburg-Mitte) als Ausgangspunkt.';
        } else {
          selectZone(res.zone);
          geoMsg.textContent = 'Dein Standort liegt am nächsten zur ' + ZONES[res.zone].name + '.';
        }
        geoMsg.classList.add('ht-msg--ok');
      },
      function (err) {
        geoBtn.disabled = false;
        if (err && err.code === 1) {
          geoMsg.textContent = 'Standortzugriff abgelehnt. Prüfe stattdessen deine PLZ oben – oder wähle eine Zone auf der Karte.';
        } else {
          selectZone(FALLBACK);
          geoMsg.textContent = 'Standort konnte nicht ermittelt werden. Wir zeigen dir die Zone Mitte & Ost (Hamburg-Mitte) als Ausgangspunkt.';
        }
        geoMsg.classList.add('ht-msg--error');
      },
      { timeout: 8000, maximumAge: 600000 }
    );
  });

  selectZone(FALLBACK);
})();
</script>
