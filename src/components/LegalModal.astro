---
/* LegalModal.astro — Impressum & Datenschutz als Fenster für die Startseite (/).
   Inhalte aus config/legal.json über geteilte Teilkomponenten
   (gleiche Quelle wie /impressum & /datenschutz).
   Die Routen selbst bleiben bestehen; das Fenster fängt nur Klicks auf die
   Footer-/Cookie-Links dieser Seite ab (gleiche Bedienung wie AjsLegalModal:
   Öffnen, Schließen per Knopf & Hintergrund, Escape, Fokus kehrt zurück).
   Fehlende Angaben stehen als sichtbare Platzhalter in eckigen Klammern;
   es werden keine Daten erfunden. */
import ImpressumContent from './legal/ImpressumContent.astro';
import DatenschutzContent from './legal/DatenschutzContent.astro';
---

<div id="hpse-impressum-modal" class="hpse-legal-modal" role="dialog" aria-modal="true" aria-labelledby="hpse-impressum-title" aria-hidden="true" hidden>
  <div class="hpse-legal-bg" data-hpse-legal-close></div>
  <div class="hpse-legal-box" tabindex="-1">
    <div class="hpse-legal-head">
      <h2 id="hpse-impressum-title" class="hpse-legal-title">Impressum</h2>
      <button type="button" class="hpse-legal-close" data-hpse-legal-close aria-label="Fenster schließen">×</button>
    </div>
    <div class="hpse-legal-body">
      <ImpressumContent level={3} />
    </div>
  </div>
</div>

<div id="hpse-datenschutz-modal" class="hpse-legal-modal" role="dialog" aria-modal="true" aria-labelledby="hpse-datenschutz-title" aria-hidden="true" hidden>
  <div class="hpse-legal-bg" data-hpse-legal-close></div>
  <div class="hpse-legal-box" tabindex="-1">
    <div class="hpse-legal-head">
      <h2 id="hpse-datenschutz-title" class="hpse-legal-title">Datenschutzerklärung</h2>
      <button type="button" class="hpse-legal-close" data-hpse-legal-close aria-label="Fenster schließen">×</button>
    </div>
    <div class="hpse-legal-body">
      <DatenschutzContent level={3} />
    </div>
  </div>
</div>

<style>
  .hpse-legal-modal { position: fixed; inset: 0; z-index: 1100; display: flex; align-items: center; justify-content: center; padding: 1rem; opacity: 0; transition: opacity .2s ease; }
  .hpse-legal-modal[hidden] { display: none; }
  .hpse-legal-modal.is-open { opacity: 1; }
  .hpse-legal-bg { position: absolute; inset: 0; background: rgba(0,0,0,.62); }
  .hpse-legal-box { position: relative; width: min(680px, 100%); max-height: min(88dvh, 820px); display: flex; flex-direction: column; background: var(--ink); color: var(--cream); border: 1px solid color-mix(in srgb, var(--cream) 16%, transparent); border-radius: 18px; box-shadow: 0 24px 70px rgba(0,0,0,.45); overflow: hidden; outline: none; transform: translateY(10px) scale(.985); transition: transform .22s ease; }
  .hpse-legal-modal.is-open .hpse-legal-box { transform: none; }
  .hpse-legal-head { flex-shrink: 0; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1.25rem; background: color-mix(in srgb, var(--accent) 82%, #000); color: var(--cream); }
  .hpse-legal-title { margin: 0; font-size: 1.3rem; font-weight: 700; color: var(--cream); }
  .hpse-legal-close { min-width: 44px; min-height: 44px; width: 44px; height: 44px; border-radius: 50%; border: 1.5px solid color-mix(in srgb, var(--cream) 35%, transparent); background: transparent; color: var(--cream); font-size: 1.5rem; line-height: 1; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; }
  .hpse-legal-close:hover { background: color-mix(in srgb, var(--cream) 14%, transparent); }
  .hpse-legal-close:focus-visible { outline: 2px solid var(--accent-light); outline-offset: 2px; }
  .hpse-legal-body { overflow-y: auto; overscroll-behavior: contain; -webkit-overflow-scrolling: touch; padding: 1.1rem 1.15rem; padding-bottom: max(1.1rem, env(safe-area-inset-bottom)); }
  @media (min-width: 640px) {
    .hpse-legal-body { padding: 1.5rem 1.8rem; }
  }
  .hpse-legal-body .legal-section { border-top: 1px solid color-mix(in srgb, var(--cream) 14%, transparent); }
  .hpse-legal-body .legal-section:first-of-type { border-top: none; }
  @media (prefers-reduced-motion: reduce) {
    .hpse-legal-modal, .hpse-legal-box { transition: none !important; transform: none !important; }
  }
</style>

<script is:inline>
(function () {
  'use strict';
  var IMPRESSUM_ID = 'hpse-impressum-modal';
  var DATENSCHUTZ_ID = 'hpse-datenschutz-modal';
  var lastFocus = null;
  var closeTimers = {};

  function getModal(id) { return document.getElementById(id); }

  function anyOtherOpen(except) {
    return [getModal(IMPRESSUM_ID), getModal(DATENSCHUTZ_ID)].some(function (m) {
      return m && m !== except && !m.hidden;
    });
  }

  function open(id) {
    var modal = getModal(id);
    if (!modal) return;
    // Laufenden Schließ-Timer dieses Fensters abbrechen (schnelles Wiederöffnen).
    if (closeTimers[id]) { clearTimeout(closeTimers[id]); closeTimers[id] = null; }
    if (!modal.hidden) return;
    // Beim Wechsel Fenster A -> B das jeweils andere sauber schließen.
    var otherId = id === IMPRESSUM_ID ? DATENSCHUTZ_ID : IMPRESSUM_ID;
    var other = getModal(otherId);
    if (other && !other.hidden) close(other);
    // Fokus nur sichern, wenn noch kein Fenster offen war.
    if (!anyOtherOpen(modal)) lastFocus = document.activeElement;
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    var body = modal.querySelector('.hpse-legal-body');
    if (body) body.scrollTop = 0;
    requestAnimationFrame(function () { modal.classList.add('is-open'); });
    document.body.classList.add('kat-open');
    var box = modal.querySelector('.hpse-legal-box');
    var closeBtn = modal.querySelector('[data-hpse-legal-close].hpse-legal-close');
    setTimeout(function () {
      try {
        if (closeBtn) closeBtn.focus({ preventScroll: true });
        else if (box) box.focus({ preventScroll: true });
      } catch (e) {
        if (closeBtn) closeBtn.focus();
        else if (box) box.focus();
      }
    }, 60);
  }

  function close(modal) {
    if (!modal || modal.hidden) return;
    modal.classList.remove('is-open');
    var othersOpen = [getModal(IMPRESSUM_ID), getModal(DATENSCHUTZ_ID)]
      .some(function (m) { return m && m !== modal && !m.hidden; });
    if (!othersOpen) document.body.classList.remove('kat-open');
    var id = modal.id;
    if (closeTimers[id]) clearTimeout(closeTimers[id]);
    closeTimers[id] = setTimeout(function () {
      closeTimers[id] = null;
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      // Fokus nur zurückgeben, wenn kein anderes Fenster offen ist.
      if (!anyOtherOpen(null) && lastFocus && lastFocus.focus) {
        try { lastFocus.focus({ preventScroll: true }); } catch (e) { lastFocus.focus(); }
        lastFocus = null;
      }
    }, 220);
  }

  function focusables(modal) {
    var box = modal.querySelector('.hpse-legal-box');
    if (!box) return [];
    var els = box.querySelectorAll(
      'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"]), input:not([disabled]), select:not([disabled]), textarea:not([disabled])'
    );
    return Array.prototype.filter.call(els, function (el) {
      return !!(el.offsetWidth || el.offsetHeight || el.getClientRects().length);
    });
  }

  // Vollständiger Focus-Trap innerhalb des aktiven Fensters (Tab / Shift+Tab).
  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Tab') return;
    var openModals = [getModal(IMPRESSUM_ID), getModal(DATENSCHUTZ_ID)].filter(function (m) { return m && !m.hidden; });
    if (!openModals.length) return;
    var modal = openModals[openModals.length - 1];
    var items = focusables(modal);
    if (!items.length) { e.preventDefault(); return; }
    var first = items[0], last = items[items.length - 1];
    if (e.shiftKey) {
      if (document.activeElement === first) { e.preventDefault(); last.focus(); }
    } else {
      if (document.activeElement === last) { e.preventDefault(); first.focus(); }
    }
  });

  function targetIdForAnchor(a) {
    if (!a) return null;
    var href = (a.getAttribute('href') || '').split('#')[0].split('?')[0];
    if (href.length > 1 && href.endsWith('/')) href = href.slice(0, -1);
    if (href === '/impressum') return IMPRESSUM_ID;
    if (href === '/datenschutz') return DATENSCHUTZ_ID;
    return null;
  }

  document.querySelectorAll('#' + IMPRESSUM_ID + ' [data-hpse-legal-close], #' + DATENSCHUTZ_ID + ' [data-hpse-legal-close]')
    .forEach(function (el) {
      el.addEventListener('click', function () {
        var modal = el.closest('.hpse-legal-modal');
        if (modal) close(modal);
      });
    });

  document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    var openModals = [getModal(IMPRESSUM_ID), getModal(DATENSCHUTZ_ID)].filter(function (m) { return m && !m.hidden; });
    if (openModals.length) {
      e.stopPropagation();
      openModals.forEach(close);
    }
  });

  // „Cookie-Einstellungen“-Knopf im Datenschutzttext: erst Fenster schließen,
  // dann Banner erneut öffnen (der CookieBanner horcht auf [data-cookie-settings]).
  document.addEventListener('click', function (e) {
    var t = e.target && e.target.closest ? e.target.closest('.hpse-legal-modal [data-cookie-settings]') : null;
    if (!t) return;
    var modal = t.closest('.hpse-legal-modal');
    if (modal) close(modal);
  }, true);

  // Links auf /impressum & /datenschutz abfangen: Fenster statt Seitennavigation.
  // Die Routen selbst bleiben als direkte Ziele erhalten (neuer Tab,
  // Rechtsklick, direkte URL-Eingabe). target=_blank wird respektiert.
  document.addEventListener('click', function (e) {
    if (e.defaultPrevented) return;
    if (e.button !== 0) return;
    if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var t = e.target && e.target.closest ? e.target.closest('a[href="/impressum"], a[href="/datenschutz"], a[href="/impressum/"], a[href="/datenschutz/"]') : null;
    if (!t) return;
    if (t.target === '_blank') return;
    var id = targetIdForAnchor(t);
    if (!id) return;
    e.preventDefault();
    open(id);
  });
})();
</script>
