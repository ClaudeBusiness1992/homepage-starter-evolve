---
/* AjsNewsletterModal.astro — reines Oberflächen-Fenster für /ajs und /ajs2.
   Erscheint einmalig verzögert nach Entsperrung des Produkt-Login-Tors,
   E-Mail-Prüfung, Schließen-Knopf, Erfolgszustand, Einmal-Logik via
   localStorage. KEINE Backend-Anbindung, KEIN Versand (offener Folgepunkt). */
---

<div id="ajs-newsletter-modal" class="kat" role="dialog" aria-modal="true" aria-labelledby="ajs-nl-title" aria-hidden="true" hidden>
  <div class="kat-bg" data-nl-close></div>
  <div class="kat-box" style="max-width: 460px; padding: 0;" tabindex="-1">
    <div class="kat-head" style="background: #414C09;">
      <h3 id="ajs-nl-title" class="kat-title" style="font-size: 1.3rem;">Neuigkeiten aus AJ&rsquo;s K&uuml;che</h3>
      <button type="button" class="kat-close" data-nl-close aria-label="Fenster schließen">&times;</button>
    </div>
    <div class="kat-body" style="padding: 1.5rem 1.8rem;">
      <div data-nl-form-view>
        <p style="font-size: 0.9rem; line-height: 1.5; color: #3B3A26; margin: 0 0 1.2rem;">
          Einmal im Monat: neues Sortiment, Touren-Termine und Angebote aus AJ&rsquo;s Feinkost-Touren &ndash; direkt in dein Postfach. Kein Spam, jederzeit abmeldbar.
        </p>
        <form id="ajsNlForm" novalidate>
          <div style="margin-bottom: 1rem;">
            <label style="display: block; font-size: 0.82rem; font-weight: 700; color: #23220F; margin-bottom: 0.35rem;" for="ajsNlEmail">E-Mail-Adresse *</label>
            <input type="email" id="ajsNlEmail" name="email" required placeholder="du@beispiel.de" autocomplete="email" aria-describedby="ajsNlError" style="width: 100%; padding: 0.65rem 0.85rem; border-radius: 8px; border: 1px solid rgba(65,76,9,0.25); background: #fff; font-size: 0.95rem; box-sizing: border-box;" />
          </div>
          <label style="display: flex; align-items: flex-start; gap: 0.5rem; font-size: 0.78rem; color: #4B4A32; cursor: pointer; margin-bottom: 1rem;">
            <input type="checkbox" id="ajsNlConsent" required style="margin-top: 2px;" />
            <span>Ich willige in den Erhalt des Newsletters ein und habe die <a href="/datenschutz" target="_blank" rel="noopener" style="color: #97572A; text-decoration: underline;">Datenschutzerkl&auml;rung</a> zur Kenntnis genommen.</span>
          </label>
          <p id="ajsNlError" role="alert" hidden style="padding: 0.6rem; border-radius: 6px; background: rgba(168,58,104,0.12); color: #A83A68; font-size: 0.82rem; margin: 0 0 1rem; text-align: center;"></p>
          <button type="submit" class="btn btn-fill" style="width: 100%; justify-content: center; padding: 0.8rem; font-weight: 700;">
            Anmelden &rarr;
          </button>
        </form>
      </div>
      <div data-nl-success-view hidden>
        <p style="font-size: 1.05rem; font-weight: 700; color: #414C09; text-align: center; margin: 0.2rem 0 0.6rem;">Danke f&uuml;r deine Anmeldung!</p>
        <p style="font-size: 0.9rem; line-height: 1.5; color: #3B3A26; text-align: center; margin: 0 0 1.2rem;">
          Bitte best&auml;tige sie noch &uuml;ber den Link in deinem Postfach.
        </p>
        <button type="button" class="btn btn-fill" data-nl-close style="width: 100%; justify-content: center; padding: 0.8rem; font-weight: 700;">
          Schlie&szlig;en
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
(function () {
  'use strict';
  var SEEN = 'ajs-nl-seen-v1';
  var DONE = 'ajs-nl-done-v1';
  var DELAY_MS = 2500;

  function store(key, val) { try { localStorage.setItem(key, val); } catch (e) {} }
  function read(key) { try { return localStorage.getItem(key); } catch (e) { return null; } }

  if (read(SEEN) || read(DONE)) return;

  var modal = document.getElementById('ajs-newsletter-modal');
  if (!modal) return;
  var form = document.getElementById('ajsNlForm');
  var email = document.getElementById('ajsNlEmail');
  var consent = document.getElementById('ajsNlConsent');
  var err = document.getElementById('ajsNlError');
  var formView = modal.querySelector('[data-nl-form-view]');
  var successView = modal.querySelector('[data-nl-success-view]');
  if (!form || !email || !consent || !err || !formView || !successView) return;
  var lastFocus = null;

  function open() {
    if (!modal.hidden) return;
    lastFocus = document.activeElement;
    modal.hidden = false;
    modal.setAttribute('aria-hidden', 'false');
    requestAnimationFrame(function () { modal.classList.add('is-open'); });
    document.body.classList.add('kat-open');
    setTimeout(function () { try { email.focus({ preventScroll: true }); } catch (e) { email.focus(); } }, 60);
  }

  function close() {
    if (modal.hidden) return;
    store(SEEN, '1');
    modal.classList.remove('is-open');
    document.body.classList.remove('kat-open');
    setTimeout(function () {
      modal.hidden = true;
      modal.setAttribute('aria-hidden', 'true');
      if (lastFocus && lastFocus.focus) { try { lastFocus.focus({ preventScroll: true }); } catch (e) { lastFocus.focus(); } }
    }, 220);
  }

  function fail(msg, field) {
    err.textContent = msg;
    err.hidden = false;
    if (field && field.focus) field.focus();
  }

  modal.querySelectorAll('[data-nl-close]').forEach(function (el) {
    el.addEventListener('click', close);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !modal.hidden) close();
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    err.hidden = true;
    var val = (email.value || '').trim();
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(val)) {
      fail('Bitte gib eine g\u00fcltige E-Mail-Adresse ein.', email);
      return;
    }
    if (!consent.checked) {
      fail('Bitte stimme dem Newsletter-Empfang zu.', consent);
      return;
    }
    store(DONE, '1');
    store(SEEN, '1');
    formView.hidden = true;
    successView.hidden = false;
    var btn = successView.querySelector('button');
    if (btn) btn.focus();
  });

  function gateOpen() {
    return document.documentElement.classList.contains('is-unlocked') || !document.querySelector('[data-gate]');
  }
  function schedule() {
    setTimeout(function () { if (!read(SEEN) && !read(DONE)) open(); }, DELAY_MS);
  }

  if (gateOpen()) {
    schedule();
  } else {
    var mo = new MutationObserver(function () {
      if (gateOpen()) { mo.disconnect(); schedule(); }
    });
    mo.observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    setTimeout(function () { mo.disconnect(); }, 120000);
  }
}());
</script>
