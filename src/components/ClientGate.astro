---
/* ClientGate.astro — kompaktes Passwort-Overlay für Kunden-Vorschau-Routen.
   Nur SHA-256-Hash im Markup (data-client-hash), niemals Klartext.
   Nach erfolgreichem Check: sessionStorage 'hp-gate-<id>' = '1', Overlay weg, Inhalt frei. */
interface Props {
  clientId: string;
  passHashSha256: string;
}
const { clientId, passHashSha256 } = Astro.props;
---

<div
  class="hp-gate"
  data-gate
  data-client-id={clientId}
  data-client-hash={passHashSha256}
  role="dialog"
  aria-modal="true"
  aria-labelledby="hp-gate-title"
>
  <form class="hp-gate-card" data-gate-form>
    <p class="hp-gate-kicker">Kunden-Vorschau</p>
    <h2 id="hp-gate-title" class="hp-gate-title">Gib das Passwort ein</h2>
    <label class="hp-gate-label" for="hp-gate-pass">Passwort</label>
    <input
      id="hp-gate-pass"
      class="hp-gate-input"
      type="password"
      name="password"
      inputmode="numeric"
      autocomplete="current-password"
      required
    />
    <p class="hp-gate-error" data-gate-error role="alert" style="display: none;">
      Falsches Passwort. Bitte erneut versuchen.
    </p>
    <button class="btn btn-fill hp-gate-btn" type="submit">Entsperren</button>
  </form>
</div>

<div class="hp-gate-content" data-gate-content style="display: none;">
  <slot />
</div>

<script is:inline>
(function () {
  var gate = document.querySelector('[data-gate]');
  var content = document.querySelector('[data-gate-content]');
  if (!gate || !content) return;
  var id = gate.getAttribute('data-client-id') || 'client';
  var want = (gate.getAttribute('data-client-hash') || '').trim().toLowerCase();
  var key = 'hp-gate-' + id;

  function unlock() {
    gate.style.display = 'none';
    gate.remove();
    content.style.display = 'block';
    content.removeAttribute('hidden');
    content.classList.add('is-unlocked');
    document.documentElement.classList.add('is-unlocked');
    document.documentElement.style.overflow = '';
  }

  document.documentElement.style.overflow = 'hidden';
  var form = gate.querySelector('[data-gate-form]');
  var input = gate.querySelector('#hp-gate-pass');
  var err = gate.querySelector('[data-gate-error]');
  if (input) input.focus();

  // Pure JavaScript SHA-256 (funktioniert immer, auch im unsicheren HTTP-Context auf mobilen IP-Adressen)
  function sha256Sync(ascii) {
    function rightRotate(value, amount) { return (value >>> amount) | (value << (32 - amount)); }
    var mathPow = Math.pow;
    var maxWord = mathPow(2, 32);
    var lengthProperty = 'length';
    var i, j, result = '';
    var words = [];
    var asciiBitLength = ascii[lengthProperty] * 8;
    var hash = [], k = [], primeCounter = 0, isComposite = {};
    for (var candidate = 2; primeCounter < 64; candidate++) {
      if (!isComposite[candidate]) {
        for (i = 0; i < 313; i += candidate) isComposite[i] = candidate;
        hash[primeCounter] = (mathPow(candidate, .5) * maxWord) | 0;
        k[primeCounter++] = (mathPow(candidate, 1/3) * maxWord) | 0;
      }
    }
    ascii += '\x80';
    while (ascii[lengthProperty] % 64 - 56) ascii += '\x00';
    for (i = 0; i < ascii[lengthProperty]; i++) {
      j = ascii.charCodeAt(i);
      words[i >> 2] |= j << ((3 - i) % 4) * 8;
    }
    words[words[lengthProperty]] = ((asciiBitLength / maxWord) | 0);
    words[words[lengthProperty]] = (asciiBitLength) | 0;
    for (j = 0; j < words[lengthProperty];) {
      var w = words.slice(j, j += 16), oldHash = hash;
      hash = hash.slice(0, 8);
      for (i = 0; i < 64; i++) {
        var w15 = w[i - 15], w2 = w[i - 2];
        var a = hash[0], e = hash[4];
        var temp1 = hash[7]
          + (rightRotate(e, 6) ^ rightRotate(e, 11) ^ rightRotate(e, 25))
          + ((e & hash[5]) ^ ((~e) & hash[6]))
          + k[i]
          + (w[i] = (i < 16) ? w[i] : (
              w[i - 16]
              + (rightRotate(w15, 7) ^ rightRotate(w15, 18) ^ (w15 >>> 3))
              + w[i - 7]
              + (rightRotate(w2, 17) ^ rightRotate(w2, 19) ^ (w2 >>> 10))
            ) | 0
          );
        var temp2 = (rightRotate(a, 2) ^ rightRotate(a, 13) ^ rightRotate(a, 22))
          + ((a & hash[1]) ^ (a & hash[2]) ^ (hash[1] & hash[2]));
        hash = [(temp1 + temp2) | 0].concat(hash);
        hash[4] = (hash[4] + temp1) | 0;
      }
      for (i = 0; i < 8; i++) hash[i] = (hash[i] + oldHash[i]) | 0;
    }
    for (i = 0; i < 8; i++) {
      for (var b = 3; b >= 0; b--) {
        var byteVal = (hash[i] >> (8 * b)) & 255;
        result += (byteVal < 16 ? '0' : '') + byteVal.toString(16);
      }
    }
    return result;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    var val = (input.value || '').trim();
    var hex = sha256Sync(val);
    if (hex === want) {
      unlock();
    } else {
      err.style.display = 'block';
      input.select();
      input.focus();
    }
  });
}());
</script>

<style>
  .hp-gate {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.25rem;
    background: var(--ink);
  }
  .hp-gate-card {
    width: min(22rem, 100%);
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
    padding: 2rem 1.75rem;
    text-align: center;
    color: var(--cream);
  }
  .hp-gate-kicker {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-light);
    margin: 0 0 0.5rem;
  }
  .hp-gate-title {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 1.5rem;
    color: var(--cream);
    margin: 0 0 1.25rem;
  }
  .hp-gate-label {
    display: block;
    text-align: left;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.35rem;
  }
  .hp-gate-input {
    width: 100%;
    box-sizing: border-box;
    padding: 0.7rem 0.9rem;
    font-size: 1rem;
    border: 1px solid var(--border-subtle);
    border-radius: var(--r);
    background: rgba(255, 255, 255, 0.05);
    color: var(--cream);
  }
  .hp-gate-input::placeholder {
    color: rgba(255, 255, 255, 0.3);
  }
  .hp-gate-input:focus {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
    border-color: var(--accent);
  }
  .hp-gate-error {
    font-size: 0.85rem;
    color: #ff6b6b;
    margin: 0.6rem 0 0;
  }
  .hp-gate-btn {
    width: 100%;
    margin-top: 1.1rem;
    justify-content: center;
  }
  .hp-gate-content {
    min-height: 100dvh;
    background: var(--ink);
  }
  .hp-gate-content.is-unlocked {
    display: block !important;
  }
</style>
