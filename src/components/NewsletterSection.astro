---
import { isSectionEnabled } from '../lib/permissions';

const isEnabled = isSectionEnabled('newsletter');
---

{isEnabled && (
  <section class="section" id="newsletter">
    <div class="wrap">
      <div class="newsletter-box">
        <div class="newsletter-content">
          <span class="lbl" style="color: #a5b4fc;">Wissen & Neuigkeiten</span>
          <h2 class="h2" style="margin: 0.5rem 0 1rem; font-size: 2rem;">
            Immer einen Schritt voraus sein
          </h2>
          <p class="sub" style="margin-bottom: 0;">
            Erhalten Sie monatlich praxiserprobte Strategien, Einblicke in moderne Web-Architekturen und rechtssichere Digital-Tipps direkt in Ihr Postfach. Kein Spam, jederzeit mit 1 Klick abmeldbar.
          </p>
        </div>

        <form class="newsletter-form" id="public-newsletter-form">
          <!-- Honeypot -->
          <div style="position: absolute; left: -9999px;">
            <input type="text" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <div class="newsletter-fields">
            <input
              type="text"
              name="firstName"
              placeholder="Ihr Vorname (optional)"
              class="nl-input"
            />
            <input
              type="email"
              name="email"
              placeholder="Ihre E-Mail-Adresse *"
              required
              class="nl-input"
            />
            <button type="submit" class="nl-btn" id="nl-submit-btn">
              Anmelden
            </button>
          </div>

          <div class="nl-consent">
            <label class="nl-consent-label">
              <input type="checkbox" required class="nl-checkbox" />
              <span>
                Ich willige in den Erhalt des Newsletters ein und habe die <a href="/datenschutz" target="_blank">Datenschutzerklärung</a> zur Kenntnis genommen.
              </span>
            </label>
          </div>

          <div id="nl-status" class="nl-status-msg"></div>
        </form>
      </div>
    </div>
  </section>
)}

<style>
  .newsletter-box {
    background: linear-gradient(135deg, rgba(99, 102, 241, 0.12) 0%, rgba(168, 85, 247, 0.08) 100%);
    border: 1px solid rgba(99, 102, 241, 0.25);
    border-radius: 1.5rem;
    padding: 3rem 2.5rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
  }
  .newsletter-fields {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    flex-wrap: wrap;
  }
  .nl-input {
    flex: 1;
    min-width: 180px;
    padding: 0.875rem 1.15rem;
    background: rgba(0, 0, 0, 0.35);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 0.75rem;
    color: #ffffff;
    font-size: 0.9375rem;
    outline: none;
    transition: border-color 0.2s;
  }
  .nl-input:focus {
    border-color: var(--accent, #6366f1);
  }
  .nl-btn {
    padding: 0.875rem 1.5rem;
    background: var(--accent, #6366f1);
    color: #ffffff;
    border: none;
    border-radius: 0.75rem;
    font-weight: 700;
    font-size: 0.9375rem;
    cursor: pointer;
    box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
    transition: background 0.2s, transform 0.15s;
    white-space: nowrap;
  }
  .nl-btn:hover { background: #4f46e5; }
  .nl-btn:active { transform: scale(0.98); }
  .nl-consent {
    font-size: 0.75rem;
    color: var(--text-muted, #94a3b8);
    line-height: 1.4;
  }
  .nl-consent-label {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    cursor: pointer;
  }
  .nl-consent a {
    color: #a5b4fc;
    text-decoration: underline;
  }
  .nl-status-msg {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    display: none;
  }

  @media (max-width: 900px) {
    .newsletter-box {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
      gap: 2rem;
    }
  }
</style>

<script is:inline>
  const nlForm = document.getElementById('public-newsletter-form');
  const nlBtn = document.getElementById('nl-submit-btn');
  const nlStatus = document.getElementById('nl-status');

  if (nlForm) {
    nlForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (nlBtn) {
        nlBtn.disabled = true;
        nlBtn.textContent = 'Wird gesendet...';
      }
      if (nlStatus) nlStatus.style.display = 'none';

      const formData = new FormData(nlForm);
      const payload = {
        firstName: formData.get('firstName'),
        email: formData.get('email'),
        website: formData.get('website'),
      };

      try {
        const res = await fetch('/api/public/newsletter/subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const d = await res.json();

        if (res.ok) {
          nlForm.reset();
          if (nlStatus) {
            nlStatus.style.color = '#34d399';
            nlStatus.textContent = d.message || 'Fast geschafft! Bitte prüfen Sie Ihr E-Mail-Postfach.';
            nlStatus.style.display = 'block';
          }
        } else {
          if (nlStatus) {
            nlStatus.style.color = '#f87171';
            nlStatus.textContent = d.error || 'Fehler bei der Anmeldung.';
            nlStatus.style.display = 'block';
          }
        }
      } catch (err) {
        if (nlStatus) {
          nlStatus.style.color = '#f87171';
          nlStatus.textContent = 'Verbindungsfehler. Bitte versuchen Sie es erneut.';
          nlStatus.style.display = 'block';
        }
      } finally {
        if (nlBtn) {
          nlBtn.disabled = false;
          nlBtn.textContent = 'Anmelden';
        }
      }
    });
  }
</script>
