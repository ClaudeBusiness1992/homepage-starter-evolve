---
interface NavLink {
  label: string;
  href: string;
  section?: string;
  cta?: boolean;
  outline?: boolean;
}
interface Props {
  siteName: string;
  siteNameAccent?: string;
  links?: NavLink[];
}
const { siteName, siteNameAccent, links = [] } = Astro.props;
const accentIdx = siteNameAccent ? siteName.indexOf(siteNameAccent) : -1;
const logoBefore = accentIdx > -1 ? siteName.slice(0, accentIdx) : siteName;
const logoAfter  = accentIdx > -1 ? siteName.slice(accentIdx + (siteNameAccent?.length ?? 0)) : '';
const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const resolveHref = (href: string) => (isHome || !href.startsWith('#')) ? href : `/${href}`;
// HPSE-AJS-KITFULL (3): Nur Login-/Registrierungs-Aktionen liegen oben rechts
// (Desktop) bzw. als Liste im Burger-Menü. Reine CTA-Links (z. B. Kontakt)
// bleiben in der Inhalts-Liste — übrige Ordnung unberührt.
const isAction = (l: NavLink) => l.section === 'login' || l.section === 'register' || !!l.outline;
const contentLinks = links.filter(l => !isAction(l));
const actionLinks = links.filter(l => isAction(l));
---

<nav id="nav" aria-label="Hauptnavigation">
  <div class="wrap">
    <div class="nav-row">
      <a href="/" class="logo">{logoBefore}{siteNameAccent && <em>{siteNameAccent}</em>}{logoAfter}</a>
      {links.length > 0 && (
        <ul class="nav-ul" id="navLinks">
          {contentLinks.map(l => (
            <li>
              <a href={resolveHref(l.href)} class={l.cta ? 'cta-link' : ''}>{l.label}</a>
            </li>
          ))}
          {actionLinks.map(l => (
            <li class="nav-action-mobile">
              <a href={resolveHref(l.href)} class={l.cta ? 'cta-link' : 'nav-btn-outline'}>{l.label}</a>
            </li>
          ))}
        </ul>
      )}
      {actionLinks.length > 0 && (
        <div class="nav-actions-desktop">
          {actionLinks.map(l => (
            <a href={resolveHref(l.href)} class={l.cta ? 'cta-link' : 'nav-btn-outline'}>{l.label}</a>
          ))}
        </div>
      )}
      <button class="burger" id="burger" aria-label="Menü" aria-expanded="false" aria-controls="navLinks">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</nav>

<script is:inline>
/* Navi-Umbruch: --nav-h der echten Leistenhöhe nachführen,
   damit Hero-Padding, Scroll-Padding und Anker-Offsets bei zweizeiliger Navi stimmen. */
(function () {
  var nav = document.getElementById('nav');
  if (!nav) return;
  function sync() {
    var h = nav.offsetHeight;
    if (h > 0) document.documentElement.style.setProperty('--nav-h', h + 'px');
  }
  sync();
  window.addEventListener('resize', sync, { passive: true });
  if ('ResizeObserver' in window) new ResizeObserver(sync).observe(nav);
})();
</script>

<style>
  /* Navi-Umbruch: Bei Platzmangel bricht die Linkliste auf
     Desktop kontrolliert in eine zweite Zeile um (zentriert), die Leiste wächst
     mit (height auto + min-height). Keine abgeschnittenen/überlappenden Punkte,
     kein horizontaler Überlauf. Mobile-Burger (<=768px) unberührt. */
  @media (min-width: 769px) {
    #nav {
      height: auto;
      min-height: var(--nav-h);
      padding-block: 0.45rem;
    }
    #nav .nav-row {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.3rem;
    }
    #nav .nav-ul {
      flex: 1 1 auto;
      flex-wrap: wrap;
      justify-content: center;
      row-gap: 0.3rem;
    }
  }
</style>

<style>
  /* HPSE-AJS-KITFULL (1): Firmenname waagerecht mittig.
     Grid-Raster: Marke in der Mittelspalte zentriert, Aktionen/Burger rechts,
     Inhalts-Links als eigene zentrierte Zeile darunter (Desktop). Ordnung
     (Logo, Links, Burger), Umbruch-Mechanik (--nav-h-Sync) und Burger bleiben
     unberührt; nur die Position der Marke ändert sich. */
  @media (min-width: 769px) {
    #nav .nav-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      grid-template-areas:
        ". brand actions"
        "links links links";
      align-items: center;
      column-gap: 1rem;
    }
    #nav .logo {
      grid-area: brand;
      margin: 0;
      justify-self: center;
      text-align: center;
      white-space: nowrap;
    }
    #nav .nav-ul {
      grid-area: links;
      justify-content: center;
    }
    #nav .nav-actions-desktop {
      grid-area: actions;
      justify-self: end;
    }
  }
  @media (max-width: 768px) {
    #nav .nav-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      align-items: center;
      gap: 0;
    }
    #nav .logo {
      grid-column: 2;
      margin: 0;
      justify-self: center;
      text-align: center;
      white-space: nowrap;
    }
    #nav .burger {
      grid-column: 3;
      justify-self: end;
    }
  }
  /* HPSE-AJS-KITFULL (3): Aktions-Buttons oben rechts (Baukasten-Theme,
     keine kundenspezifischen Farben). */
  #nav .nav-btn-outline {
    display: inline-block;
    font-weight: 700;
    white-space: nowrap;
    padding: 0.42rem 1.05rem;
    color: var(--cream);
    background: transparent;
    border: 1.5px solid var(--accent-light, #e2a63b);
    border-radius: 999px;
    text-decoration: none;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  #nav .nav-btn-outline:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: #fff;
    transform: translateY(-1px);
  }
  #nav .nav-btn-outline:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  #nav .nav-actions-desktop {
    display: none;
  }
  @media (min-width: 769px) {
    #nav .nav-actions-desktop {
      display: inline-flex;
      align-items: center;
      gap: 0.55rem;
      flex: 0 0 auto;
      flex-wrap: wrap;
      justify-content: flex-end;
    }
    #nav .nav-actions-desktop a.cta-link,
    #nav .nav-actions-desktop a.nav-btn-outline {
      font-size: 0.8rem;
      padding: 0.42rem 0.95rem;
    }
    #nav .nav-ul li.nav-action-mobile {
      display: none;
    }
  }
  @media (max-width: 768px) {
    #nav .nav-actions-desktop {
      display: none;
    }
    #nav .nav-ul.open a.nav-btn-outline,
    #nav .nav-ul.open a.cta-link {
      display: block;
      text-align: center;
    }
  }
</style>
