# Beispiel für /etc/hpse/backup.env auf dem Hauptserver (Rechte 600, Besitzer root). Nie committen.
# Platzhalter ersetzen. Echte Werte nur auf dem Hauptserver.

# Sicherungsziel (Hetzner Storage Box, SFTP-Port 23). Benutzer und Host nur hier, nicht im Repo.
RESTIC_REPOSITORY=sftp:uXXXXXX@uXXXXXX.your-storagebox.de:hpse-repo
# Pfad zu einer Datei (Rechte 600) mit dem restic-Passwort. Eine Kopie liegt getrennt und offline.
RESTIC_PASSWORD_FILE=/etc/hpse/restic-passwort
# SSH-Schlüssel nur für Anfügen (auf der Box mit erzwungenem Befehl --append-only hinterlegt)
HPSE_SSH_KEY=/etc/hpse/id_backup_append

# Was gesichert wird
HPSE_DUMP_DIR=/var/backups/hpse/dumps
HPSE_MEDIA_DIR=/srv/hpse/media
HPSE_CONFIG_DIR=/etc/hpse/config-ohne-schluessel
# Kundendatenbanken, Leerzeichen getrennt (eine Datenbank je Kunde)
HPSE_DATABASES="hpse_eigene_homepage"
PGHOST=127.0.0.1
PGUSER=hpse_backup
# Datenbankpasswort per ~/.pgpass des Sicherungsbenutzers, nicht hier.

# Alarm (nur Betriebsmeldungen, keine Kundendaten)
NTFY_TOPIC=
